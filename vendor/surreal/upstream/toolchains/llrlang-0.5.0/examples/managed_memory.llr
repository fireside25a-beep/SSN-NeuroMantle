(fn main (argc argv)
  (let r (call llr_region_new 32))
  (if (== r 0) (block (return 1)) (block))
  (call llr_region_set64 r 8 123456789)
  (let x (call llr_region_get64 r 8))
  (call llr_print_i64 x)
  (call llr_write_all 1 "\n" 1)
  (call llr_region_free r)
  (if (== x 123456789) (block (return 0)) (block (return 2))))
