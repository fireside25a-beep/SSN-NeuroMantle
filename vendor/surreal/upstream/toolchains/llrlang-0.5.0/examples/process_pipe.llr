(fn main (argc argv)
  (let pp (call llr_pipe_new))
  (if (== pp 0) (block (return 1)) (block))
  (let rd (call llr_pipe_read_fd pp))
  (let wr (call llr_pipe_write_fd pp))
  (let pid (call llr_fork))
  (if (< pid 0) (block (return 2)) (block))
  (if (== pid 0)
    (block
      (call llr_close rd)
      (call llr_send wr "message from child\n" 19)
      (call llr_close wr)
      (call llr_exit 0))
    (block))
  (call llr_close wr)
  (let buf (syscall6 9 0 64 3 34 -1 0))
  (if (< buf 0) (block (return 3)) (block))
  (let got (call llr_recv rd buf 64))
  (if (> got 0) (block (call llr_write_all 1 buf got)) (block))
  (call llr_close rd)
  (let status (syscall6 9 0 8 3 34 -1 0))
  (call llr_wait pid status)
  (syscall2 11 status 8)
  (syscall2 11 buf 64)
  (syscall2 11 pp 8)
  (if (== got 19) (block (return 0)) (block (return 4))))
