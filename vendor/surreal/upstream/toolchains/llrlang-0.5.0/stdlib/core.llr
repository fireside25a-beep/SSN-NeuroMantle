; LLRLANG core library
(fn llr_strlen (p)
  (let n 0)
  (while (!= (load8 p n) 0) (block (set n (+ n 1))))
  (return n))

(fn llr_streq (a b)
  (let i 0)
  (while 1
    (block
      (let x (load8 a i))
      (let y (load8 b i))
      (if (!= x y) (block (return 0)) (block))
      (if (== x 0) (block (return 1)) (block))
      (set i (+ i 1))))
  (return 0))

(fn llr_memcpy (dst src n)
  (let i 0)
  (while (< i n)
    (block (store8 dst i (load8 src i)) (set i (+ i 1))))
  (return dst))

(fn llr_memset (dst v n)
  (let i 0)
  (while (< i n)
    (block (store8 dst i v) (set i (+ i 1))))
  (return dst))

(fn llr_exit (code)
  (syscall1 60 code)
  (return code))
