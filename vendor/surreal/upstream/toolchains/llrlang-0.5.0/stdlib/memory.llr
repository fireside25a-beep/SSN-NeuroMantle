; Managed byte-region API. Descriptor layout: [base:i64, length:i64].
(fn llr_region_new (n)
  (if (<= n 0) (block (return 0)) (block))
  (let d (syscall6 9 0 16 3 34 -1 0))
  (if (< d 0) (block (return 0)) (block))
  (let p (syscall6 9 0 n 3 34 -1 0))
  (if (< p 0) (block (syscall2 11 d 16) (return 0)) (block))
  (store64 d 0 p)
  (store64 d 8 n)
  (return d))

(fn llr_region_len (d)
  (if (== d 0) (block (return 0)) (block))
  (return (load64 d 8)))

(fn llr_region_base (d)
  (if (== d 0) (block (return 0)) (block))
  (return (load64 d 0)))

(fn llr_region_check1 (d off)
  (if (== d 0) (block (return 0)) (block))
  (if (< off 0) (block (return 0)) (block))
  (if (>= off (load64 d 8)) (block (return 0)) (block))
  (return 1))

(fn llr_region_check8 (d off)
  (if (== d 0) (block (return 0)) (block))
  (if (< off 0) (block (return 0)) (block))
  (let n (load64 d 8))
  (if (> off n) (block (return 0)) (block))
  (if (> 8 (- n off)) (block (return 0)) (block))
  (return 1))

(fn llr_region_get8 (d off)
  (if (== (call llr_region_check1 d off) 0) (block (call llr_exit 124)) (block))
  (return (load8 (load64 d 0) off)))

(fn llr_region_set8 (d off v)
  (if (== (call llr_region_check1 d off) 0) (block (call llr_exit 124)) (block))
  (store8 (load64 d 0) off v)
  (return v))

(fn llr_region_get64 (d off)
  (if (== (call llr_region_check8 d off) 0) (block (call llr_exit 124)) (block))
  (return (load64 (load64 d 0) off)))

(fn llr_region_set64 (d off v)
  (if (== (call llr_region_check8 d off) 0) (block (call llr_exit 124)) (block))
  (store64 (load64 d 0) off v)
  (return v))

(fn llr_region_free (d)
  (if (== d 0) (block (return 0)) (block))
  (let p (load64 d 0))
  (let n (load64 d 8))
  (let r1 (syscall2 11 p n))
  (let r2 (syscall2 11 d 16))
  (if (< r1 0) (block (return r1)) (block))
  (return r2))
