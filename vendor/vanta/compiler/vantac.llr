  (if (== (call op_eq p n "!=") 1) (block (return 1)) (block))
  (if (== (call op_eq p n "<") 1) (block (return 1)) (block))
  (if (== (call op_eq p n "<=") 1) (block (return 1)) (block))
  (if (== (call op_eq p n ">") 1) (block (return 1)) (block))
  (if (== (call op_eq p n ">=") 1) (block (return 1)) (block))
  (return 0))

(fn insert_skipped_zeroes (st off)
  (let slot 0)
  (let count 0)
  (let nlocal (call sget st 112))
  (let generation (call sget st 160))
  (let zero_map (call sget st 168))
  (while (< slot nlocal)
    (block
      (if (== (load64 zero_map (* slot 8)) generation)
        (block (set count (+ count 1)))
        (block))
      (set slot (+ slot 1))))
  (if (== count 0) (block (return 0)) (block))
  (let add (+ 2 (* count 7)))
  (let old (call sget st 56))
  (if (> (+ old add) 16777216)
    (block (call die "vantac: error: output exceeds release limit\n"))
    (block))
  (let codebuf (call sget st 48))
  (let i old)
  (while (> i off)
    (block
      (set i (- i 1))
      (store8 codebuf (+ i add) (load8 codebuf i))))
  (let pos off)
  (store8 codebuf pos 49)
  (store8 codebuf (+ pos 1) 192)
  (set pos (+ pos 2))
  (set slot 0)
  (while (< slot nlocal)
    (block
      (if (== (load64 zero_map (* slot 8)) generation)
        (block
          (let d (neg (* 8 (+ slot 1))))
          (store8 codebuf pos 72)
          (store8 codebuf (+ pos 1) 137)
          (store8 codebuf (+ pos 2) 133)
          (call put32 codebuf (+ pos 3) d)
          (set pos (+ pos 7)))
        (block))
      (set slot (+ slot 1))))
  (call sset st 56 (+ old add))
  (let pidx 0)
  (let np (call sget st 88))
  (while (< pidx np)
    (block
      (let patch (call patchptr st pidx))
      (if (>= (load64 patch 8) off)
        (block (store64 patch 8 (+ (load64 patch 8) add)))
        (block))
      (set pidx (+ pidx 1))))
  (return count))

(fn compile_function (st f)
  (call cur_set st (+ (load64 f 16) 4))
  (call sset st 112 0)
  (call sset st 152 0)
  (call sset st 176 0)
  (call sset st 160 (+ (call sget st 160) 1))
  (let pi 0)
  (while (!= (call tkind st (call cur_get st)) 2)
    (block
      (let pti (call cur_get st))
      (if (!= (call find_local st (call tptr st pti) (call tlen st pti)) 0) (block (call die_at st pti "duplicate parameter")) (block))
      (call add_local st (call tptr st pti) (call tlen st pti) pti)
      (call cur_inc st)
      (set pi (+ pi 1))))
  (call cur_inc st)
  (store64 f 32 (call sget st 56))
  (call c1 st 85)
  (call c1 st 72) (call c1 st 137) (call c1 st 229)
  (call c1 st 72) (call c1 st 129) (call c1 st 236) (call c4 st 2048)
  (let pidx 0)
  (while (< pidx pi)
    (block (call emit_param_store st pidx pidx) (set pidx (+ pidx 1))))
  (let zero_off (call sget st 56))
  (while (!= (call tkind st (call cur_get st)) 2)
    (block (call compile_expr st 1)))
  (call expect_rp st)
  (call emit_mov_rax_imm st 0)
  (call c1 st 201) (call c1 st 195)
  (if (== (call sget st 176) 1)
    (block (call insert_skipped_zeroes st zero_off))
    (block))
  (return 0))

(fn emit_start (st)
  ; Deterministic binary64 process state: MXCSR=0x1f80 (RN-even, masked exceptions, FTZ/DAZ off).
  ; sub rsp,8
  (call c1 st 72) (call c1 st 131) (call c1 st 236) (call c1 st 8)
  ; mov dword [rsp],0x00001f80
  (call c1 st 199) (call c1 st 4) (call c1 st 36) (call c4 st 8064)
  ; ldmxcsr [rsp]
  (call c1 st 15) (call c1 st 174) (call c1 st 20) (call c1 st 36)
  ; add rsp,8
  (call c1 st 72) (call c1 st 131) (call c1 st 196) (call c1 st 8)
  (call c1 st 72) (call c1 st 139) (call c1 st 60) (call c1 st 36)
  (call c1 st 72) (call c1 st 141) (call c1 st 116) (call c1 st 36) (call c1 st 8)
  (call c1 st 232)
  (let imm (call mark4 st))
  (call add_patch st 1 imm 0 "main" 4)
  ; If the trusted runtime provides the resource auditor, preserve main's return
  ; value across it and make leak-freedom part of normal successful execution.
  (let audit (call find_func_span st "__vanta_priv_resource_audit" 27))
  (if (!= audit 0)
    (block
      (call c1 st 80)
      (call c1 st 232)
      (let aimm (call mark4 st))
      (call add_patch st 1 aimm 0 "__vanta_priv_resource_audit" 27)
      (call c1 st 88))
    (block))
  (call c1 st 72) (call c1 st 137) (call c1 st 199)
  (call c1 st 72) (call c1 st 199) (call c1 st 192) (call c4 st 60)
  (call c1 st 15) (call c1 st 5) (call c1 st 244)
  (return 0))

(fn resolve_patches (st)
  (let i 0)
  (let np (call sget st 88))
  (let code_end (call sget st 56))
  (while (< i np)
    (block
      (let p (call patchptr st i))
      (let kind (load64 p 0))
      (let imm (load64 p 8))
      (if (== kind 1)
        (block
          (let f (call find_func_span st (load64 p 24) (load64 p 32)))
          (if (== f 0) (block (call die "vantac: error: unresolved function patch\n")) (block))
          (call patch_rel st imm (load64 f 32)))
        (block
          (if (== kind 2)
            (block
              (let rel (- (+ code_end (load64 p 16)) (+ imm 4)))
              (call patch4_code st imm rel))
            (block (call die "vantac: error: invalid patch kind\n")))))
      (set i (+ i 1))))
  (return 0))

(fn put16 (p off x)
  (store8 p off (& x 255))
  (store8 p (+ off 1) (& (>> x 8) 255))
  (return 0))

(fn put32 (p off x)
  (store8 p off (& x 255))
  (store8 p (+ off 1) (& (>> x 8) 255))
  (store8 p (+ off 2) (& (>> x 16) 255))
  (store8 p (+ off 3) (& (>> x 24) 255))
  (return 0))

(fn put64 (p off x)
  (store8 p off (& x 255))
  (store8 p (+ off 1) (& (>> x 8) 255))
  (store8 p (+ off 2) (& (>> x 16) 255))
  (store8 p (+ off 3) (& (>> x 24) 255))
  (store8 p (+ off 4) (& (>> x 32) 255))
  (store8 p (+ off 5) (& (>> x 40) 255))
  (store8 p (+ off 6) (& (>> x 48) 255))
  (store8 p (+ off 7) (& (>> x 56) 255))
  (return 0))

(fn mem_copy (dst src n)
  (let i 0)
  (while (< i n)
    (block
      (store8 dst i (load8 src i))
      (set i (+ i 1))))
  (return 0))

(fn write_elf (st out)
  (call resolve_patches st)
  (let cn (call sget st 56))
  (let rn (call sget st 72))
  (let total (+ 4096 (+ cn rn)))
  (let img (call alloc total))
  ; ELF identification
  (store8 img 0 127) (store8 img 1 69) (store8 img 2 76) (store8 img 3 70)
  (store8 img 4 2) (store8 img 5 1) (store8 img 6 1)
  (call put16 img 16 3)
  (call put16 img 18 62)
  (call put32 img 20 1)
  (call put64 img 24 4096)
  (call put64 img 32 64)
  (call put64 img 40 0)
  (call put32 img 48 0)
  (call put16 img 52 64)
  (call put16 img 54 56)
  (call put16 img 56 2)
  (call put16 img 58 0)
  (call put16 img 60 0)
  (call put16 img 62 0)
  ; Position-independent executable LOAD segment, matching the bootstrap seed exactly.
  (call put32 img 64 1)
  (call put32 img 68 5)
  (call put64 img 72 0)
  (call put64 img 80 0)
  (call put64 img 88 0)
  (call put64 img 96 total)
  (call put64 img 104 total)
  (call put64 img 112 4096)
  ; Explicit non-executable process stack.
  (call put32 img 120 1685382481)
  (call put32 img 124 6)
  (call put64 img 128 0)
  (call put64 img 136 0)
  (call put64 img 144 0)
  (call put64 img 152 0)
  (call put64 img 160 0)
  (call put64 img 168 16)
  (call mem_copy (+ img 4096) (call sget st 48) cn)
  (call mem_copy (+ img (+ 4096 cn)) (call sget st 64) rn)
  (let fd (syscall4 257 -100 out 577 493))
  (if (< fd 0) (block (call die "vantac: error: cannot create output\n")) (block))
  (if (!= (call write_all fd img total) 0) (block (call die "vantac: error: output write failed\n")) (block))
  (if (< (syscall2 91 fd 493) 0) (block (call die "vantac: error: output chmod failed\n")) (block))
  (syscall1 3 fd)
  (return total))

(fn compile_all (st)
  (call sset st 48 (call alloc 16777216))
  (call sset st 56 0)
  (call sset st 64 (call alloc 8388608))
  (call sset st 72 0)
  (call sset st 80 (call alloc 2621440))
  (call sset st 88 0)
  (call sset st 104 (call alloc 12288))
  (call sset st 112 0)
  (call sset st 152 0)
  (call sset st 160 0)
  (call sset st 168 (call alloc 2048))
  (call sset st 176 0)
  (call emit_start st)
  (let i 0)
  (let nf (call sget st 40))
  (while (< i nf)
    (block
      (call compile_function st (call funcptr st i))
      (set i (+ i 1))))
  (return (call sget st 56)))

(fn main (argc argv)
  (if (== argc 2)
    (block
      (let a1 (load64 argv 8))
      (if (== (call streq a1 "--version") 1)
        (block
          (call write_all 1 "vantac 1.2.1-native\n" 20)
          (return 0))
        (block)))
    (block))
  (if (< argc 4) (block (call die "usage: vantac <runtime.llr ...> <program.vnt> -o <output>\n")) (block))
  (let flag (load64 argv (* (- argc 2) 8)))
  (let output_path (load64 argv (* (- argc 1) 8)))
  (if (== (call streq flag "-o") 0) (block (call die "usage: vantac <runtime.llr ...> <program.vnt> -o <output>\n")) (block))
  (let st (call alloc 4096))
  (call read_inputs st argc argv)
  (call lex st)
  (call inventory st)
  (call compile_all st)
  (call write_elf st output_path)
  (return 0))
