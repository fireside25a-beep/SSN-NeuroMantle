(fn require_nth_type (st nth want)
  (let ti (call cur_get st))
  (let i 0)
  (while (< i nth)
    (block
      (if (== (call tkind st ti) 2) (block (return 0)) (block))
      (set ti (call skip_form st ti))
      (set i (+ i 1))))
