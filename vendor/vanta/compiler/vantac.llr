(fn try_affine_loop (st cond)
  ; Recognizes a pure counted affine recurrence and replaces the complete loop with
  ; a mathematically equivalent O(log N) compile-time exponentiation plus two stores.
  ; All non-matching loops fall back to the normal direct native code generator.
  (if (!= (call tkind st cond) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ cond 1) "<") 0) (block (return 0)) (block))
  (if (!= (call tkind st (+ cond 2)) 3) (block (return 0)) (block))
  (if (!= (call tkind st (+ cond 3)) 4) (block (return 0)) (block))
  (if (!= (call tkind st (+ cond 4)) 2) (block (return 0)) (block))
  (let it (+ cond 2))
  (let limit (call tiv st (+ cond 3)))
  (let b (+ cond 5))
  (if (!= (call tkind st b) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ b 1) "block") 0) (block (return 0)) (block))

  (let s1 (+ b 2))
  (if (!= (call tkind st s1) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ s1 1) "set") 0) (block (return 0)) (block))
  (if (!= (call tkind st (+ s1 2)) 3) (block (return 0)) (block))
  (let xt (+ s1 2))
  (let e (+ s1 3))
  (if (!= (call tkind st e) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ e 1) "&") 0) (block (return 0)) (block))
  (let add (+ e 2))
  (if (!= (call tkind st add) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ add 1) "+") 0) (block (return 0)) (block))
  (let mul (+ add 2))
  (if (!= (call tkind st mul) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ mul 1) "*") 0) (block (return 0)) (block))
  (if (== (call tok_same_ident st (+ mul 2) xt) 0) (block (return 0)) (block))
  (if (!= (call tkind st (+ mul 3)) 4) (block (return 0)) (block))
  (if (!= (call tkind st (+ mul 4)) 2) (block (return 0)) (block))
  (let ct (+ mul 5))
  (if (!= (call tkind st ct) 4) (block (return 0)) (block))
  (if (!= (call tkind st (+ ct 1)) 2) (block (return 0)) (block))
  (let mt (+ ct 2))
  (if (!= (call tkind st mt) 4) (block (return 0)) (block))
  (if (!= (call tkind st (+ mt 1)) 2) (block (return 0)) (block))
  (let set1_end (+ mt 2))
  (if (!= (call tkind st set1_end) 2) (block (return 0)) (block))

  (let s2 (+ set1_end 1))
  (if (!= (call tkind st s2) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ s2 1) "set") 0) (block (return 0)) (block))
  (if (== (call tok_same_ident st (+ s2 2) it) 0) (block (return 0)) (block))
  (let inc (+ s2 3))
  (if (!= (call tkind st inc) 1) (block (return 0)) (block))
  (if (== (call tok_id_name st (+ inc 1) "+") 0) (block (return 0)) (block))
  (if (== (call tok_same_ident st (+ inc 2) it) 0) (block (return 0)) (block))
  (if (!= (call tkind st (+ inc 3)) 4) (block (return 0)) (block))
  (if (!= (call tiv st (+ inc 3)) 1) (block (return 0)) (block))
  (if (!= (call tkind st (+ inc 4)) 2) (block (return 0)) (block))
  (if (!= (call tkind st (+ inc 5)) 2) (block (return 0)) (block))
  (let bend (+ inc 6))
  (if (!= (call tkind st bend) 2) (block (return 0)) (block))
  (if (!= (call tkind st (+ bend 1)) 2) (block (return 0)) (block))

  (let il (call find_local st (call tptr st it) (call tlen st it)))
  (let xl (call find_local st (call tptr st xt) (call tlen st xt)))
  (if (== il 0) (block (return 0)) (block))
