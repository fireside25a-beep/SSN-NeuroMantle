; LLRLANG native self-hosting compiler 0.5.0
; The compiler is written in the language it compiles and emits ELF64 x86-64 directly.

(fn cstrlen (p)
  (let n 0)
  (while (!= (load8 p n) 0) (block (set n (+ n 1))))
  (return n))

(fn write_all (fd p n)
  (let off 0)
  (while (< off n)
    (block
      (let r (syscall3 1 fd (+ p off) (- n off)))
      (if (<= r 0) (block (return -1)) (block))
      (set off (+ off r))))
  (return 0))

(fn die (msg)
  (call write_all 2 msg (call cstrlen msg))
  (syscall1 60 2)
  (return 2))

(fn alloc (n)
  (let p (syscall6 9 0 n 3 34 -1 0))
  (if (< p 0) (block (call die "vantac: error: memory allocation failed\n")) (block))
  (return p))

(fn streq (a b)
  (let i 0)
  (while 1
    (block
      (let x (load8 a i))
      (let y (load8 b i))
      (if (!= x y) (block (return 0)) (block))
      (if (== x 0) (block (return 1)) (block))
      (set i (+ i 1))))
  (return 0))

(fn span_eq (a an b bn)
  (if (!= an bn) (block (return 0)) (block))
  (let i 0)
  (while (< i an)
    (block
      (if (!= (load8 a i) (load8 b i)) (block (return 0)) (block))
      (set i (+ i 1))))
  (return 1))

(fn is_space (c)
  (if (== c 32) (block (return 1)) (block))
  (if (== c 9) (block (return 1)) (block))
  (if (== c 10) (block (return 1)) (block))
  (if (== c 13) (block (return 1)) (block))
  (return 0))

(fn is_digit (c)
  (if (< c 48) (block (return 0)) (block))
  (if (> c 57) (block (return 0)) (block))
  (return 1))

(fn sget (st off) (return (load64 st off)))
(fn sset (st off v) (store64 st off v) (return v))

; State offsets:
; 0 src, 8 src_len, 16 toks, 24 ntok, 32 funcs, 40 nfunc,
; 48 code, 56 code_n, 64 ro, 72 ro_n, 80 patches, 88 npatch,
; 96 cur, 104 locals, 112 nlocal, 120 nest,
; 136 files (entries of [start_offset:i64, path:i64]), 144 nfiles.

(fn write_dec (fd v)
  ; v is non-negative. Writes decimal digits without a newline.
  (let buf (call alloc 32))
  (let i 31)
  (store8 buf i 0)
  (if (== v 0) (block (set i (- i 1)) (store8 buf i 48)) (block))
  (while (> v 0)
    (block
      (set i (- i 1))
      (store8 buf i (+ 48 (% v 10)))
      (set v (/ v 10))))
  (call write_all fd (+ buf i) (- 31 i))
  (return 0))

(fn die_at_ptr (st p msg)
  ; Report an error positioned at source byte pointer p: PATH:LINE:COL.
  (let src (call sget st 0))
  (let off (- p src))
  (let files (call sget st 136))
  (let nfiles (call sget st 144))
  (let fi 0)
  (let i 1)
  (while (< i nfiles)
    (block
      (if (<= (load64 files (* i 16)) off) (block (set fi i)) (block))
      (set i (+ i 1))))
  (let start (load64 files (* fi 16)))
  (let path (load64 files (+ (* fi 16) 8)))
  (let line 1)
  (let col 1)
  (let j start)
  (while (< j off)
    (block
      (if (== (load8 src j) 10)
        (block (set line (+ line 1)) (set col 1))
        (block (set col (+ col 1))))
      (set j (+ j 1))))
  (call write_all 2 "vantac: " 6)
  (call write_all 2 path (call cstrlen path))
  (call write_all 2 ":" 1)
  (call write_dec 2 line)
  (call write_all 2 ":" 1)
  (call write_dec 2 col)
  (call write_all 2 ": error: " 9)
  (call write_all 2 msg (call cstrlen msg))
  (call write_all 2 "\n" 1)
  (syscall1 60 2)
  (return 2))

(fn die_at (st ti msg)
  ; Report an error positioned at token index ti. Out-of-range indices clamp to the last token.
  (let nt (call sget st 24))
  (if (>= ti nt) (block (set ti (- nt 1))) (block))
  (if (< ti 0) (block (set ti 0)) (block))
  ; String tokens point at their first content byte; report the opening quote.
  (let p (call tptr st ti))
  (if (== (call tkind st ti) 5) (block (set p (- p 1))) (block))
  (return (call die_at_ptr st p msg)))

(fn read_inputs (st argc argv)
  (let cap 8388608)
  (let buf (call alloc (+ cap 1)))
  (let files (call alloc 4096))
  (call sset st 136 files)
  (call sset st 144 0)
  (let n 0)
  (let ai 1)
  (while (< ai (- argc 2))
    (block
      (let path_i (load64 argv (* ai 8)))
      (let nfiles (call sget st 144))
      (if (>= nfiles 256) (block (call die "vantac: error: too many input files (limit 256)\n")) (block))
      (store64 files (* nfiles 16) n)
      (store64 files (+ (* nfiles 16) 8) path_i)
      (call sset st 144 (+ nfiles 1))
      (let fd_i (syscall4 257 -100 path_i 0 0))
      (if (< fd_i 0)
        (block
          (call write_all 2 "vantac: error: cannot open input: " 32)
          (call write_all 2 path_i (call cstrlen path_i))
          (call die "\n"))
        (block))
      (let file_done 0)
      (while (== file_done 0)
        (block
          (if (== n cap)
            (block
              (let extra_i (syscall3 0 fd_i (+ buf n) 1))
              (if (> extra_i 0) (block (call die "vantac: error: combined input exceeds 8 MiB limit\n")) (block))
              (set file_done 1))
            (block
              (let r_i (syscall3 0 fd_i (+ buf n) (- cap n)))
              (if (< r_i 0) (block (call die "vantac: error: read error\n")) (block))
              (if (== r_i 0) (block (set file_done 1)) (block (set n (+ n r_i))))))))
      (syscall1 3 fd_i)
      (if (< ai (- argc 3))
        (block
          (if (== n cap) (block (call die "vantac: error: combined input exceeds 8 MiB limit\n")) (block))
          (store8 buf n 10)
          (set n (+ n 1)))
        (block))
      (set ai (+ ai 1))))
  (store8 buf n 0)
  (call sset st 0 buf)
  (call sset st 8 n)
  (return n))

(fn tokptr (st i) (return (+ (call sget st 16) (* i 32))))
(fn tkind (st i) (return (load64 (call tokptr st i) 0)))
(fn tptr (st i) (return (load64 (call tokptr st i) 8)))
(fn tlen (st i) (return (load64 (call tokptr st i) 16)))
(fn tiv (st i) (return (load64 (call tokptr st i) 24)))

(fn add_tok (st k p n iv)
  (let nt (call sget st 24))
  (if (>= nt 262144) (block (call die "vantac: error: too many tokens\n")) (block))
  (let t (call tokptr st nt))
  (store64 t 0 k)
  (store64 t 8 p)
  (store64 t 16 n)
  (store64 t 24 iv)
  (call sset st 24 (+ nt 1))
  (return nt))

(fn numeric_token (p n)
  (if (== n 0) (block (return 0)) (block))
  (let i 0)
  (if (== (load8 p 0) 45)
    (block
      (if (== n 1) (block (return 0)) (block))
      (set i 1))
    (block))
  (while (< i n)
    (block
      (if (== (call is_digit (load8 p i)) 0) (block (return 0)) (block))
      (set i (+ i 1))))
  (return 1))

(fn parse_int (st p n)
  ; Accumulate negatively so INT64_MIN is representable.
  (let neg 0)
  (let i 0)
  (if (== (load8 p 0) 45) (block (set neg 1) (set i 1)) (block))
  (let v 0)
  (while (< i n)
    (block
      (let d (- (load8 p i) 48))
      (if (< v (/ (+ -9223372036854775808 d) 10)) (block (call die_at_ptr st p "integer literal overflow")) (block))
      (set v (- (* v 10) d))
      (set i (+ i 1))))
  (if (== neg 1) (block (return v)) (block))
  (if (== v -9223372036854775808) (block (call die_at_ptr st p "integer literal overflow")) (block))
  (return (neg v)))

(fn skip_comment (st i)
  (let src_c (call sget st 0))
  (let len_c (call sget st 8))
  (while (< i len_c)
    (block
      (if (== (load8 src_c i) 10) (block (return i)) (block))
      (set i (+ i 1))))
  (return i))

(fn lex_string (st i)
  (let src_s (call sget st 0))
  (let len_s (call sget st 8))
  (let start_s (+ i 1))
  (set i (+ i 1))
  (let esc_s 0)
  (while (< i len_s)
    (block
      (let ch_s (load8 src_s i))
      (if (== esc_s 1)
        (block (set esc_s 0) (set i (+ i 1)))
        (block
          (if (== ch_s 92)
            (block (set esc_s 1) (set i (+ i 1)))
            (block
              (if (== ch_s 34)
                (block
                  (call add_tok st 5 (+ src_s start_s) (- i start_s) 0)
                  (return (+ i 1)))
                (block
                  (if (== ch_s 10) (block (call die_at_ptr st (+ src_s i) "newline in string literal")) (block))
                  (set i (+ i 1))))))))))
  (call die_at_ptr st (+ src_s (- start_s 1)) "unterminated string literal")
  (return i))

(fn word_stop (c)
  (if (== (call is_space c) 1) (block (return 1)) (block))
  (if (== c 40) (block (return 1)) (block))
  (if (== c 41) (block (return 1)) (block))
  (if (== c 59) (block (return 1)) (block))
  (if (== c 34) (block (return 1)) (block))
  (return 0))

(fn lex_word (st i)
  (let src_w (call sget st 0))
  (let len_w (call sget st 8))
  (let start_w i)
  (let done_w 0)
  (while (== done_w 0)
    (block
      (if (>= i len_w)
        (block (set done_w 1))
        (block
          (if (== (call word_stop (load8 src_w i)) 1)
            (block (set done_w 1))
            (block (set i (+ i 1))))))))
  (let n_w (- i start_w))
  (if (== n_w 0) (block (call die_at_ptr st (+ src_w start_w) "invalid token")) (block))
  (if (== (call numeric_token (+ src_w start_w) n_w) 1)
    (block (call add_tok st 4 (+ src_w start_w) n_w (call parse_int st (+ src_w start_w) n_w)))
    (block (call add_tok st 3 (+ src_w start_w) n_w 0)))
  (return i))

(fn lex (st)
  (call sset st 16 (call alloc 8388608))
  (call sset st 24 0)
  (let src_l (call sget st 0))
  (let len_l (call sget st 8))
  (let i_l 0)
  (while (< i_l len_l)
    (block
      (let c_l (load8 src_l i_l))
      (if (== c_l 59)
        (block (set i_l (call skip_comment st i_l)))
        (block
          (if (== (call is_space c_l) 1)
            (block (set i_l (+ i_l 1)))
            (block
              (if (== c_l 40)
                (block (call add_tok st 1 (+ src_l i_l) 1 0) (set i_l (+ i_l 1)))
                (block
                  (if (== c_l 41)
                    (block (call add_tok st 2 (+ src_l i_l) 1 0) (set i_l (+ i_l 1)))
                    (block
                      (if (== c_l 34)
                        (block (set i_l (call lex_string st i_l)))
                        (block (set i_l (call lex_word st i_l))))))))))))))
  (call add_tok st 6 (+ src_l len_l) 0 0)
  (return (call sget st 24)))

(fn id_eq (st ti s)
  (if (!= (call tkind st ti) 3) (block (return 0)) (block))
  (return (call span_eq (call tptr st ti) (call tlen st ti) s (call cstrlen s))))

(fn skip_form (st i)
  (if (!= (call tkind st i) 1) (block (return (+ i 1))) (block))
  (let d 0)
  (let nt (call sget st 24))
  (while (< i nt)
    (block
      (let k (call tkind st i))
      (if (== k 1) (block (set d (+ d 1))) (block))
      (if (== k 2)
        (block
          (set d (- d 1))
          (if (== d 0) (block (return (+ i 1))) (block)))
        (block))
      (if (== k 6) (block (call die_at st i "unbalanced parentheses")) (block))
      (set i (+ i 1))))
  (call die_at st i "unbalanced parentheses")
  (return i))

(fn funcptr (st i) (return (+ (call sget st 32) (* i 40))))
(fn find_func_span (st p n)
  (let i 0)
  (let nf (call sget st 40))
  (while (< i nf)
    (block
      (let f (call funcptr st i))
      (if (== (call span_eq p n (load64 f 0) (load64 f 8)) 1) (block (return f)) (block))
      (set i (+ i 1))))
  (return 0))

(fn inventory (st)
  (call sset st 32 (call alloc 40960))
  (call sset st 40 0)
  (let i 0)
  (while (!= (call tkind st i) 6)
    (block
      (let header_ok 1)
      (if (!= (call tkind st i) 1) (block (set header_ok 0)) (block))
      (if (== (call id_eq st (+ i 1) "fn") 0) (block (set header_ok 0)) (block))
      (if (!= (call tkind st (+ i 2)) 3) (block (set header_ok 0)) (block))
      (if (!= (call tkind st (+ i 3)) 1) (block (set header_ok 0)) (block))
      (if (== header_ok 0) (block (call die_at st i "top level expects (fn name (params...) ...)")) (block))
      (let nf (call sget st 40))
      (if (>= nf 1024) (block (call die_at st i "too many functions")) (block))
      (let np (call tptr st (+ i 2)))
      (let nn (call tlen st (+ i 2)))
      (if (== (call token_is_user st (+ i 2)) 1)
        (block
          (if (== (call span_starts np nn "__vanta_priv_") 1)
            (block (call die_at st (+ i 2) "reserved runtime function cannot be defined in .vnt"))
            (block)))
        (block))
      (if (!= (call find_func_span st np nn) 0) (block (call die_at st (+ i 2) "duplicate function")) (block))
      (let j (+ i 4))
      (let ar 0)
      (while (!= (call tkind st j) 2)
        (block
          (if (== (call tkind st j) 6) (block (call die_at st i "unterminated parameter list")) (block))
          (if (!= (call tkind st j) 3) (block (call die_at st j "parameter must be identifier")) (block))
          (set ar (+ ar 1))
          (if (> ar 6) (block (call die_at st j "functions support at most 6 parameters")) (block))
          (set j (+ j 1))))
      (let f (call funcptr st nf))
      (store64 f 0 np)
      (store64 f 8 nn)
      (store64 f 16 i)
      (store64 f 24 ar)
      (store64 f 32 -1)
      (call sset st 40 (+ nf 1))
      (set i (call skip_form st i))))
  (let mf (call find_func_span st "main" 4))
  (if (== mf 0) (block (call die_at st 0 "missing main function")) (block))
  (if (!= (load64 mf 24) 2) (block (call die_at st (load64 mf 16) "main must accept exactly two parameters")) (block))
  (return (call sget st 40)))

(fn localptr (st i) (return (+ (call sget st 104) (* i 48))))
(fn find_local (st p n)
  (let i (call sget st 112))
  (while (> i 0)
    (block
      (set i (- i 1))
      (let l (call localptr st i))
      (if (== (call span_eq p n (load64 l 0) (load64 l 8)) 1) (block (return l)) (block))))
  (return 0))

(fn add_local (st p n ti)
  (if (!= (call find_local st p n) 0) (block (call die_at st ti "duplicate local")) (block))
  (let nl (call sget st 112))
  (if (>= nl 256) (block (call die_at st (call cur_get st) "too many locals")) (block))
  (let l (call localptr st nl))
  (store64 l 0 p)
  (store64 l 8 n)
  (store64 l 16 nl)
  (store64 l 24 0)
  (store64 l 32 0)
  (store64 l 40 0)
  (call sset st 112 (+ nl 1))
  (return nl))

(fn patchptr (st i) (return (+ (call sget st 80) (* i 40))))
(fn add_patch (st kind imm target name namelen)
  (let np (call sget st 88))
  (if (>= np 65536) (block (call die "vantac: error: too many patches\n")) (block))
  (let p (call patchptr st np))
  (store64 p 0 kind)
  (store64 p 8 imm)
  (store64 p 16 target)
  (store64 p 24 name)
  (store64 p 32 namelen)
  (call sset st 88 (+ np 1))
  (return np))

(fn c1 (st x)
  (let n (call sget st 56))
  (if (>= n 16777216) (block (call die "vantac: error: output exceeds release limit\n")) (block))
  (store8 (call sget st 48) n x)
  (call sset st 56 (+ n 1))
  (return n))

(fn c4 (st x)
  (call c1 st (& x 255))
  (call c1 st (& (>> x 8) 255))
  (call c1 st (& (>> x 16) 255))
  (call c1 st (& (>> x 24) 255))
  (return (- (call sget st 56) 4)))

(fn c8 (st x)
  (call c1 st (& x 255))
  (call c1 st (& (>> x 8) 255))
  (call c1 st (& (>> x 16) 255))
  (call c1 st (& (>> x 24) 255))
  (call c1 st (& (>> x 32) 255))
  (call c1 st (& (>> x 40) 255))
  (call c1 st (& (>> x 48) 255))
  (call c1 st (& (>> x 56) 255))
  (return (- (call sget st 56) 8)))

(fn patch4_code (st off x)
  (let p (+ (call sget st 48) off))
  (store8 p 0 (& x 255))
  (store8 p 1 (& (>> x 8) 255))
  (store8 p 2 (& (>> x 16) 255))
  (store8 p 3 (& (>> x 24) 255))
  (return 0))

(fn mark4 (st)
  (let o (call sget st 56))
  (call c4 st 0)
  (return o))

(fn patch_rel (st imm target)
  (call patch4_code st imm (- target (+ imm 4)))
  (return 0))

(fn emit_push_rax (st) (call c1 st 80) (return 0))

(fn emit_pop_reg (st r)
  (if (== r 0) (block (call c1 st 88) (return 0)) (block))
  (if (== r 1) (block (call c1 st 95) (return 0)) (block))
  (if (== r 2) (block (call c1 st 94) (return 0)) (block))
  (if (== r 3) (block (call c1 st 90) (return 0)) (block))
  (if (== r 4) (block (call c1 st 89) (return 0)) (block))
  (if (== r 5) (block (call c1 st 65) (call c1 st 88) (return 0)) (block))
  (if (== r 6) (block (call c1 st 65) (call c1 st 89) (return 0)) (block))
  (if (== r 7) (block (call c1 st 65) (call c1 st 90) (return 0)) (block))
  (call die "vantac: error: internal register error\n")
  (return -1))

(fn emit_mov_rax_imm (st x)
  (call c1 st 72)
  (call c1 st 184)
  (call c8 st x)
  (return 0))

(fn emit_load_slot (st slot)
  (let d (neg (* 8 (+ slot 1))))
  (call c1 st 72) (call c1 st 139) (call c1 st 133) (call c4 st d)
  (return 0))

(fn emit_store_slot (st slot)
  (let d (neg (* 8 (+ slot 1))))
  (call c1 st 72) (call c1 st 137) (call c1 st 133) (call c4 st d)
  (return 0))

(fn emit_test_rax (st) (call c1 st 72) (call c1 st 133) (call c1 st 192) (return 0))

(fn emit_jcc (st cc)
  (call c1 st 15) (call c1 st cc)
  (return (call mark4 st)))

(fn emit_jmp (st)
  (call c1 st 233)
  (return (call mark4 st)))

(fn emit_exit_trap (st ec)
  (call c1 st 72) (call c1 st 199) (call c1 st 199) (call c4 st ec)
  (call c1 st 72) (call c1 st 199) (call c1 st 192) (call c4 st 60)
  (call c1 st 15) (call c1 st 5)
  (return 0))

(fn emit_overflow_guard (st)
  (let jno (call emit_jcc st 129))
  (call emit_exit_trap st 122)
  (call patch_rel st jno (call sget st 56))
  (return 0))

(fn add_ro_byte (st x)
  (let n (call sget st 72))
  (if (>= n 8388608) (block (call die "vantac: error: output exceeds release limit\n")) (block))
  (store8 (call sget st 64) n x)
  (call sset st 72 (+ n 1))
  (return n))

(fn decode_escape (st ti c)
  (if (== c 110) (block (return 10)) (block))
  (if (== c 114) (block (return 13)) (block))
  (if (== c 116) (block (return 9)) (block))
  (if (== c 48) (block (return 0)) (block))
  (if (== c 92) (block (return 92)) (block))
  (if (== c 34) (block (return 34)) (block))
  (call die_at st ti "unsupported string escape")
  (return 0))

(fn add_string_tok (st ti)
  (let off (call sget st 72))
  (let p (call tptr st ti))
  (let n (call tlen st ti))
  (let i 0)
  (while (< i n)
    (block
      (let c (load8 p i))
      (if (== c 92)
        (block
          (set i (+ i 1))
          (if (>= i n) (block (call die_at st ti "bad string escape")) (block))
          (set c (call decode_escape st ti (load8 p i))))
        (block))
      (call add_ro_byte st c)
      (set i (+ i 1))))
  (call add_ro_byte st 0)
  (return off))

(fn cur_get (st) (return (call sget st 96)))
(fn cur_set (st x) (call sset st 96 x) (return x))
(fn cur_inc (st) (let x (+ (call cur_get st) 1)) (call cur_set st x) (return x))

(fn op_eq (p n s)
  (return (call span_eq p n s (call cstrlen s))))

(fn expect_rp (st)
  (let c (call cur_get st))
  (if (!= (call tkind st c) 2) (block (call die_at st c "expected )")) (block))
  (call cur_set st (+ c 1))
  (return 0))

(fn emit_param_store (st idx slot)
  (let d (neg (* 8 (+ slot 1))))
  (if (== idx 0) (block (call c1 st 72) (call c1 st 137) (call c1 st 189) (call c4 st d) (return 0)) (block))
  (if (== idx 1) (block (call c1 st 72) (call c1 st 137) (call c1 st 181) (call c4 st d) (return 0)) (block))
  (if (== idx 2) (block (call c1 st 72) (call c1 st 137) (call c1 st 149) (call c4 st d) (return 0)) (block))
  (if (== idx 3) (block (call c1 st 72) (call c1 st 137) (call c1 st 141) (call c4 st d) (return 0)) (block))
  (if (== idx 4) (block (call c1 st 76) (call c1 st 137) (call c1 st 133) (call c4 st d) (return 0)) (block))
  (call c1 st 76) (call c1 st 137) (call c1 st 141) (call c4 st d)
  (return 0))


(fn span_starts (p n prefix)
  (let pn (call cstrlen prefix))
  (if (< n pn) (block (return 0)) (block))
  (return (call span_eq p pn prefix pn)))

(fn path_ends_with (p suffix)
  (let n (call cstrlen p))
  (let sn (call cstrlen suffix))
  (if (< n sn) (block (return 0)) (block))
  (return (call span_eq (+ p (- n sn)) sn suffix sn)))

(fn token_file_path (st ti)
  (let src (call sget st 0))
  (let off (- (call tptr st ti) src))
  (let files (call sget st 136))
  (let nfiles (call sget st 144))
  (let fi 0)
  (let i 1)
  (while (< i nfiles)
    (block
