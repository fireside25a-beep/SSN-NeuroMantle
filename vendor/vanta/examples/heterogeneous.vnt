(fn main (argc argv)
  (let host (domain-new 0 1048576))
  (let accel (domain-new 1 1048576))
  (let cpu (topology-new))
  (let gpu (topology-new))
  (topology-add cpu host)
  (topology-add gpu accel)
  (let fabric (fabric-new))
  (fabric-link fabric host accel 10)
  (fabric-link fabric accel host 10)

  (let a (tensor-new2 2 2 host))
  (let b (tensor-new2 2 2 host))
  (let c (tensor-new2 2 2 host))
  (tensor-set64 cpu a 0 0 1)
  (tensor-set64 cpu a 0 1 2)
  (tensor-set64 cpu a 1 0 3)
  (tensor-set64 cpu a 1 1 4)
  (tensor-set64 cpu b 0 0 5)
  (tensor-set64 cpu b 0 1 6)
  (tensor-set64 cpu b 1 0 7)
  (tensor-set64 cpu b 1 1 8)
  (tensor-matmul64 cpu a b c)
  (print-int (tensor-get64 cpu c 0 0))
  (print-int (tensor-get64 cpu c 0 1))
  (print-int (tensor-get64 cpu c 1 0))
  (print-int (tensor-get64 cpu c 1 1))

  (let moved (tensor-transfer c accel fabric))
  (print-int (tensor-get64 gpu moved 1 1))
  (tensor-free moved)
  (tensor-free c)
  (tensor-free b)
  (tensor-free a)
  (fabric-free fabric)
  (topology-free gpu)
  (topology-free cpu)
  (domain-free accel)
  (domain-free host)
  (return 0))
