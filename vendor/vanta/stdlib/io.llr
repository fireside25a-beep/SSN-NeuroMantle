    (block
      (set negv 1)
      (if (== v -9223372036854775808)
        (block
          (call __vanta_priv_write_all 1 "-9223372036854775808\n" 21)
          (call __vanta_priv_unmap buf 64)
          (return v))
        (block (set v (neg v)))))
    (block))
  (if (== v 0) (block (store8 buf i 48) (set i (- i 1))) (block))
  (while (> v 0)
    (block
      (store8 buf i (+ 48 (% v 10)))
      (set i (- i 1))
      (set v (/ v 10))))
  (if (== negv 1) (block (store8 buf i 45) (set i (- i 1))) (block))
