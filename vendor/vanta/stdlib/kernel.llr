; Vanta native trusted runtime kernel. User .vnt files cannot call __vanta_priv_* directly.
; Handle table: fixed 1 MiB arena at 0x600000000000. Slot 0 is header; slots are 64 bytes.

(fn __vanta_priv_write_all (fd p n)
  (let off 0)
  (while (< off n)
    (block
      (let r (syscall3 1 fd (+ p off) (- n off)))
      (if (<= r 0) (block (return -1)) (block))
      (set off (+ off r))))
  (return 0))

(fn __vanta_priv_panic (code msg n)
  (call __vanta_priv_write_all 2 "vanta: runtime trap: " 21)
  (call __vanta_priv_write_all 2 msg n)
  (call __vanta_priv_write_all 2 "\n" 1)
  (syscall1 60 code)
  (return code))

(fn __vanta_priv_table_base ()
  (let base 105553116266496)
  (let r (syscall6 9 base 1048576 3 1048610 -1 0))
  (if (== r base)
    (block
      (store64 base 0 6215335084561486405)
      (return base))
    (block))
  (if (== r -17)
    (block
      (if (== (load64 base 0) 6215335084561486405)
        (block (return base))
        (block (call __vanta_priv_panic 126 "handle arena collision" 22))))
    (block))
  (call __vanta_priv_panic 126 "cannot reserve handle arena" 27)
  (return 0))

(fn __vanta_priv_slot_raw (idx)
  (return (+ (call __vanta_priv_table_base) (* idx 64))))

(fn __vanta_priv_handle_index (h)
  (return (& h 16383)))

(fn __vanta_priv_handle_generation (h)
  (return (>> h 14)))

(fn __vanta_priv_slot (h kind)
  (if (<= h 0) (block (call __vanta_priv_panic 124 "invalid handle" 14)) (block))
  (let idx (call __vanta_priv_handle_index h))
  (let gen (call __vanta_priv_handle_generation h))
  (if (<= idx 0) (block (call __vanta_priv_panic 124 "invalid handle" 14)) (block))
  (if (> idx 16383) (block (call __vanta_priv_panic 124 "invalid handle" 14)) (block))
  (if (<= gen 0) (block (call __vanta_priv_panic 124 "invalid handle generation" 25)) (block))
  (let p (call __vanta_priv_slot_raw idx))
  (if (!= (load64 p 0) kind) (block (call __vanta_priv_panic 124 "handle kind mismatch" 20)) (block))
  (if (!= (load64 p 56) gen) (block (call __vanta_priv_panic 124 "stale handle generation" 23)) (block))
  (return p))

(fn __vanta_priv_random_generation (old)
  (let base (call __vanta_priv_table_base))
  (let gen old)
  (while (== gen old)
    (block
      (let r (syscall3 318 (+ base 8) 8 0))
      (if (!= r 8)
        (block (call __vanta_priv_panic 126 "kernel randomness unavailable" 27))
        (block))
      ; Keep handles positive: 47 random bits plus a fixed high generation bit.
      (set gen (| (& (load64 base 8) 140737488355327) 140737488355328))))
  (return gen))

(fn __vanta_priv_alloc_slot (kind)
  (let idx 1)
  (while (<= idx 16383)
    (block
      (let p (call __vanta_priv_slot_raw idx))
      (if (== (load64 p 0) 0)
        (block
          (let gen (call __vanta_priv_random_generation (load64 p 56)))
          (store64 p 0 kind)
          (store64 p 8 0)
          (store64 p 16 0)
          (store64 p 24 0)
          (store64 p 32 0)
          (store64 p 40 0)
          (store64 p 48 0)
          (store64 p 56 gen)
          (return (| (<< gen 14) idx)))
        (block))
      (set idx (+ idx 1))))
  (call __vanta_priv_panic 126 "handle table exhausted" 22)
  (return 0))

(fn __vanta_priv_clear_slot (h)
  (let idx (call __vanta_priv_handle_index h))
  (let p (call __vanta_priv_slot_raw idx))
  (let gen (load64 p 56))
  (store64 p 0 0)
  (store64 p 8 0)
  (store64 p 16 0)
  (store64 p 24 0)
  (store64 p 32 0)
  (store64 p 40 0)
  (store64 p 48 0)
  (store64 p 56 gen)
  (return 0))

(fn __vanta_priv_map (n)
  (if (<= n 0) (block (return 0)) (block))
  (let p (syscall6 9 0 n 3 34 -1 0))
  (if (< p 0) (block (return 0)) (block))
  (return p))

(fn __vanta_priv_unmap (p n)
  (if (== p 0) (block (return 0)) (block))
  (return (syscall2 11 p n)))

(fn __vanta_priv_memcpy (dst src n)
  (let i 0)
  (while (< i n)
    (block
      (store8 dst i (load8 src i))
      (set i (+ i 1))))
  (return dst))

(fn __vanta_priv_resource_audit ()
  (let idx 1)
  (while (<= idx 16383)
    (block
      (let p (call __vanta_priv_slot_raw idx))
      (if (!= (load64 p 0) 0)
        (block (call __vanta_priv_panic 136 "live Vanta resource at program exit" 35))
        (block))
      (set idx (+ idx 1))))
  (return 0))
