; Deterministic i64 -> i64 hash map backed by Vanta capability memory.
; kind 12 = map [kind, cap, len, capacity, domain, 0, 0, generation]
; Entry layout: occupied:i64, key:i64, value:i64 (24 bytes).

(fn __vanta_priv_map_slot (m)
  (return (call __vanta_priv_slot m 12)))

(fn __vanta_priv_map_pow2 (n)
  (if (<= n 0) (block (return 8)) (block))
  (let p 8)
  (while (< p n)
    (block
      (if (> p 268435456)
        (block (call __vanta_priv_panic 134 "map capacity too large" 22))
        (block))
      (set p (* p 2))))
  (return p))

(fn __vanta_priv_map_hash (key)
  (let x (^ key (>> key 33)))
  (set x (wrap* x -7046029254386353131))
  (set x (^ x (>> x 29)))
  (return (& x 9223372036854775807)))

(fn __vanta_priv_map_new (initial_capacity domain)
  (call __vanta_priv_slot domain 5)
  (let capn (call __vanta_priv_map_pow2 initial_capacity))
  (let bytes (* capn 24))
  (let cap (call __vanta_priv_mem_new bytes domain 7))
  (let m (call __vanta_priv_alloc_slot 12))
  (let p (call __vanta_priv_map_slot m))
  (store64 p 8 cap)
  (store64 p 16 0)
  (store64 p 24 capn)
  (store64 p 32 domain)
  (return m))

(fn __vanta_priv_map_len (m)
  (return (load64 (call __vanta_priv_map_slot m) 16)))

(fn __vanta_priv_map_capacity (m)
  (return (load64 (call __vanta_priv_map_slot m) 24)))

(fn __vanta_priv_map_find_slot (topo cap capacity key)
  (let start (% (call __vanta_priv_map_hash key) capacity))
  (let step 0)
  (while (< step capacity)
    (block
      (let idx (% (+ start step) capacity))
      (let off (* idx 24))
      (let occupied (call __vanta_priv_mem_load64 topo cap off))
      (if (== occupied 0) (block (return idx)) (block))
      (if (== (call __vanta_priv_mem_load64 topo cap (+ off 8)) key)
        (block (return idx))
        (block))
      (set step (+ step 1))))
  (call __vanta_priv_panic 134 "map probe exhausted" 19)
  (return 0))

(fn __vanta_priv_map_insert_nogrow (topo p key value)
  (let cap (load64 p 8))
  (let capacity (load64 p 24))
  (let idx (call __vanta_priv_map_find_slot topo cap capacity key))
  (let off (* idx 24))
  (let occupied (call __vanta_priv_mem_load64 topo cap off))
  (if (== occupied 0)
    (block
      (call __vanta_priv_mem_store64 topo cap off 1)
      (call __vanta_priv_mem_store64 topo cap (+ off 8) key)
      (call __vanta_priv_mem_store64 topo cap (+ off 16) value)
      (store64 p 16 (+ (load64 p 16) 1))
      (return 1))
    (block))
  (call __vanta_priv_mem_store64 topo cap (+ off 16) value)
  (return 0))

(fn __vanta_priv_map_grow (topo m)
  (let p (call __vanta_priv_map_slot m))
  (let oldcap (load64 p 8))
  (let oldn (load64 p 24))
  (if (> oldn 268435456)
    (block (call __vanta_priv_panic 134 "map capacity overflow" 21))
    (block))
  (let newn (* oldn 2))
  (let domain (load64 p 32))
  (let newcap (call __vanta_priv_mem_new (* newn 24) domain 7))
  (store64 p 8 newcap)
  (store64 p 16 0)
  (store64 p 24 newn)
  (let i 0)
  (while (< i oldn)
    (block
      (let off (* i 24))
      (if (!= (call __vanta_priv_mem_load64 topo oldcap off) 0)
        (block
          (let key (call __vanta_priv_mem_load64 topo oldcap (+ off 8)))
          (let value (call __vanta_priv_mem_load64 topo oldcap (+ off 16)))
          (call __vanta_priv_map_insert_nogrow topo p key value))
        (block))
      (set i (+ i 1))))
  (call __vanta_priv_mem_free oldcap)
  (return m))

(fn __vanta_priv_map_put (topo m key value)
  (let p (call __vanta_priv_map_slot m))
  (let len (load64 p 16))
  (let capacity (load64 p 24))
  (if (> (* (+ len 1) 10) (* capacity 7))
    (block
      (call __vanta_priv_map_grow topo m)
      (set p (call __vanta_priv_map_slot m)))
    (block))
  (call __vanta_priv_map_insert_nogrow topo p key value)
  (return value))

(fn __vanta_priv_map_has (topo m key)
  (let p (call __vanta_priv_map_slot m))
  (let cap (load64 p 8))
  (let capacity (load64 p 24))
  (let start (% (call __vanta_priv_map_hash key) capacity))
  (let step 0)
  (while (< step capacity)
    (block
      (let idx (% (+ start step) capacity))
      (let off (* idx 24))
      (if (== (call __vanta_priv_mem_load64 topo cap off) 0) (block (return 0)) (block))
      (if (== (call __vanta_priv_mem_load64 topo cap (+ off 8)) key) (block (return 1)) (block))
      (set step (+ step 1))))
  (return 0))

(fn __vanta_priv_map_get (topo m key)
  (let p (call __vanta_priv_map_slot m))
  (let cap (load64 p 8))
  (let capacity (load64 p 24))
  (let start (% (call __vanta_priv_map_hash key) capacity))
  (let step 0)
  (while (< step capacity)
    (block
      (let idx (% (+ start step) capacity))
      (let off (* idx 24))
      (if (== (call __vanta_priv_mem_load64 topo cap off) 0)
        (block (call __vanta_priv_panic 134 "map key not found" 17))
        (block))
      (if (== (call __vanta_priv_mem_load64 topo cap (+ off 8)) key)
        (block (return (call __vanta_priv_mem_load64 topo cap (+ off 16))))
        (block))
      (set step (+ step 1))))
  (call __vanta_priv_panic 134 "map key not found" 17)
  (return 0))

(fn __vanta_priv_map_free (m)
  (let p (call __vanta_priv_map_slot m))
  (call __vanta_priv_mem_free (load64 p 8))
  (call __vanta_priv_clear_slot m)
  (return 0))
