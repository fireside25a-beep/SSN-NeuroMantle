; Capability memory + domains. Public access is exposed through compiler intrinsics.
; slot kind 1 = memory capability: [kind, base, len, domain_handle, perms, root_handle, refs, flags]
; slot kind 5 = memory domain:     [kind, id, capacity, used, 0, 0, 0, 0]
; permissions: READ=1 WRITE=2 TRANSFER=4.

(fn __vanta_priv_domain_new (id capacity)
  (if (< id 0) (block (call __vanta_priv_panic 127 "negative domain id" 18)) (block))
  (if (> id 62) (block (call __vanta_priv_panic 127 "domain id exceeds 62" 20)) (block))
  (if (< capacity 0) (block (call __vanta_priv_panic 127 "negative domain capacity" 24)) (block))
  (let h 1)
  (while (<= h 16383)
    (block
      (let scanp (call __vanta_priv_slot_raw h))
      (if (== (load64 scanp 0) 5)
        (block
          (if (== (load64 scanp 8) id)
            (block (call __vanta_priv_panic 127 "duplicate domain id" 19))
            (block)))
        (block))
      (set h (+ h 1))))
  (let d (call __vanta_priv_alloc_slot 5))
  (let p (call __vanta_priv_slot d 5))
  (store64 p 8 id)
  (store64 p 16 capacity)
  (store64 p 24 0)
  (return d))

(fn __vanta_priv_domain_used (domain)
  (return (load64 (call __vanta_priv_slot domain 5) 24)))

(fn __vanta_priv_domain_reserve (domain n)
  (let p (call __vanta_priv_slot domain 5))
  (let cap (load64 p 16))
  (let used (load64 p 24))
  (if (< n 0) (block (call __vanta_priv_panic 127 "negative reservation" 20)) (block))
  (if (> used cap) (block (call __vanta_priv_panic 127 "corrupt domain usage" 20)) (block))
  (if (> n (- cap used)) (block (call __vanta_priv_panic 127 "domain capacity exceeded" 24)) (block))
  (store64 p 24 (+ used n))
  (return (+ used n)))

(fn __vanta_priv_domain_release (domain n)
  (let p (call __vanta_priv_slot domain 5))
  (let used (load64 p 24))
  (if (< n 0) (block (call __vanta_priv_panic 127 "negative release" 16)) (block))
  (if (> n used) (block (call __vanta_priv_panic 127 "domain usage underflow" 22)) (block))
  (store64 p 24 (- used n))
  (return (- used n)))

(fn __vanta_priv_cap_slot (h)
  (return (call __vanta_priv_slot h 1)))

(fn __vanta_priv_mem_new (n domain perms)
  (if (<= n 0) (block (call __vanta_priv_panic 124 "allocation size must be positive" 32)) (block))
  (if (< perms 0) (block (call __vanta_priv_panic 124 "invalid permissions" 19)) (block))
  (if (> perms 7) (block (call __vanta_priv_panic 124 "invalid permissions" 19)) (block))
  (call __vanta_priv_slot domain 5)
  (call __vanta_priv_domain_reserve domain n)
  (let raw (call __vanta_priv_map n))
  (if (== raw 0)
    (block
      (call __vanta_priv_domain_release domain n)
      (call __vanta_priv_panic 124 "memory mapping failed" 21))
    (block))
  (let h (call __vanta_priv_alloc_slot 1))
  (let p (call __vanta_priv_cap_slot h))
  (store64 p 8 raw)
  (store64 p 16 n)
  (store64 p 24 domain)
  (store64 p 32 perms)
  (store64 p 40 h)
  (store64 p 48 1)
  (return h))

(fn __vanta_priv_mem_len (cap)
  (return (load64 (call __vanta_priv_cap_slot cap) 16)))

(fn __vanta_priv_mem_domain (cap)
  (return (load64 (call __vanta_priv_cap_slot cap) 24)))

(fn __vanta_priv_cap_require (cap perm)
  (let p (call __vanta_priv_cap_slot cap))
  (if (== (& (load64 p 32) perm) 0)
    (block (call __vanta_priv_panic 124 "capability permission denied" 28))
    (block))
  (return p))

(fn __vanta_priv_cap_bounds (p off width)
  (if (< off 0) (block (call __vanta_priv_panic 124 "negative capability offset" 26)) (block))
  (if (< width 0) (block (call __vanta_priv_panic 124 "negative access width" 21)) (block))
  (let n (load64 p 16))
  (if (> off n) (block (call __vanta_priv_panic 124 "capability bounds violation" 28)) (block))
  (if (> width (- n off)) (block (call __vanta_priv_panic 124 "capability bounds violation" 28)) (block))
  (return 1))

(fn __vanta_priv_topology_check_mem (topo cap)
  (let tp (call __vanta_priv_slot topo 4))
  (let cp (call __vanta_priv_cap_slot cap))
  (let domain (load64 cp 24))
  (let dp (call __vanta_priv_slot domain 5))
  (let id (load64 dp 8))
  (let mask (load64 tp 8))
  (if (== (& mask (<< 1 id)) 0)
    (block (call __vanta_priv_panic 128 "topology cannot access memory domain" 36))
    (block))
  (return 1))

(fn __vanta_priv_mem_load8 (topo cap off)
  (call __vanta_priv_topology_check_mem topo cap)
  (let p (call __vanta_priv_cap_require cap 1))
  (call __vanta_priv_cap_bounds p off 1)
  (return (load8 (load64 p 8) off)))

(fn __vanta_priv_mem_load64 (topo cap off)
  (call __vanta_priv_topology_check_mem topo cap)
  (let p (call __vanta_priv_cap_require cap 1))
  (call __vanta_priv_cap_bounds p off 8)
  (return (load64 (load64 p 8) off)))

(fn __vanta_priv_mem_store8 (topo cap off v)
  (call __vanta_priv_topology_check_mem topo cap)
  (let p (call __vanta_priv_cap_require cap 2))
  (call __vanta_priv_cap_bounds p off 1)
  (store8 (load64 p 8) off v)
  (return v))

(fn __vanta_priv_mem_store64 (topo cap off v)
  (call __vanta_priv_topology_check_mem topo cap)
  (let p (call __vanta_priv_cap_require cap 2))
  (call __vanta_priv_cap_bounds p off 8)
  (store64 (load64 p 8) off v)
  (return v))

(fn __vanta_priv_mem_sub (cap off n)
  (let p (call __vanta_priv_cap_slot cap))
  (call __vanta_priv_cap_bounds p off n)
  (let root (load64 p 40))
  (let rp (call __vanta_priv_cap_slot root))
  (let h (call __vanta_priv_alloc_slot 1))
  (let q (call __vanta_priv_cap_slot h))
  (store64 q 8 (+ (load64 p 8) off))
  (store64 q 16 n)
  (store64 q 24 (load64 p 24))
  (store64 q 32 (load64 p 32))
  (store64 q 40 root)
  (store64 q 48 0)
  (store64 rp 48 (+ (load64 rp 48) 1))
  (return h))

(fn __vanta_priv_mem_seal (cap)
  (let p (call __vanta_priv_cap_slot cap))
  (store64 p 32 (& (load64 p 32) 5))
  (return cap))

(fn __vanta_priv_mem_free (cap)
  (let p (call __vanta_priv_cap_slot cap))
  (let root (load64 p 40))
  (let rp (call __vanta_priv_cap_slot root))
  (if (== cap root)
    (block
      (if (!= (load64 rp 48) 1)
        (block (call __vanta_priv_panic 124 "root capability still has sub-capabilities" 39))
        (block))
      (let n (load64 rp 16))
      (let raw (load64 rp 8))
      (let domain (load64 rp 24))
      (call __vanta_priv_unmap raw n)
      (call __vanta_priv_domain_release domain n)
      (call __vanta_priv_clear_slot root)
      (return 0))
    (block))
  (if (<= (load64 rp 48) 1)
    (block (call __vanta_priv_panic 124 "corrupt capability reference count" 34))
    (block))
  (store64 rp 48 (- (load64 rp 48) 1))
  (call __vanta_priv_clear_slot cap)
  (return 0))

(fn __vanta_priv_domain_free (domain)
  (let p (call __vanta_priv_slot domain 5))
  (if (!= (load64 p 24) 0)
    (block (call __vanta_priv_panic 127 "domain still owns live memory" 29))
    (block))
  (call __vanta_priv_clear_slot domain)
  (return 0))
