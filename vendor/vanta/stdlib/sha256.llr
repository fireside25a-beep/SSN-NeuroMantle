(fn __vanta_priv_sha_u32 (x) (return (& x 4294967295)))
(fn __vanta_priv_sha_rotr (x n)
  (let a (>> (& x 4294967295) n))
  (let b (<< (& x 4294967295) (- 32 n)))
  (return (& (| a b) 4294967295)))

