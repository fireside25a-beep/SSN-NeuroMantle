(fn __vanta_priv_sha_block (ctx block)
  (let w (call __vanta_priv_map 512))
  (if (== w 0) (block (call __vanta_priv_panic 135 "sha256 schedule allocation failed" 33)) (block))
  (let i 0)
  (while (< i 16)
    (block
      (let off (* i 4))
      (let x (| (<< (load8 block off) 24)
                 (| (<< (load8 block (+ off 1)) 16)
                    (| (<< (load8 block (+ off 2)) 8)
                       (load8 block (+ off 3))))))
      (store64 w (* i 8) x)
      (set i (+ i 1))))
  (while (< i 64)
    (block
      (let wa (load64 w (* (- i 15) 8)))
      (let wb (load64 w (* (- i 2) 8)))
      (let s0 (^ (^ (call __vanta_priv_sha_rotr wa 7) (call __vanta_priv_sha_rotr wa 18)) (>> wa 3)))
      (let s1 (^ (^ (call __vanta_priv_sha_rotr wb 17) (call __vanta_priv_sha_rotr wb 19)) (>> wb 10)))
      (let wx (+ (+ (load64 w (* (- i 16) 8)) s0) (+ (load64 w (* (- i 7) 8)) s1)))
      (store64 w (* i 8) (& wx 4294967295))
      (set i (+ i 1))))
  (let a (load64 ctx 0))
  (let b (load64 ctx 8))
  (let c (load64 ctx 16))
  (let d (load64 ctx 24))
  (let e (load64 ctx 32))
  (let f (load64 ctx 40))
  (let g (load64 ctx 48))
  (let h (load64 ctx 56))
  (set i 0)
  (while (< i 64)
    (block
      (let S1 (^ (^ (call __vanta_priv_sha_rotr e 6) (call __vanta_priv_sha_rotr e 11)) (call __vanta_priv_sha_rotr e 25)))
      (let ch (^ (& e f) (& (^ e 4294967295) g)))
      (let temp1 (& (+ (+ (+ (+ h S1) ch) (call __vanta_priv_sha_k i)) (load64 w (* i 8))) 4294967295))
      (let S0 (^ (^ (call __vanta_priv_sha_rotr a 2) (call __vanta_priv_sha_rotr a 13)) (call __vanta_priv_sha_rotr a 22)))
      (let maj (^ (^ (& a b) (& a c)) (& b c)))
      (let temp2 (& (+ S0 maj) 4294967295))
      (set h g)
      (set g f)
      (set f e)
      (set e (& (+ d temp1) 4294967295))
      (set d c)
      (set c b)
      (set b a)
      (set a (& (+ temp1 temp2) 4294967295))
      (set i (+ i 1))))
  (store64 ctx 0 (& (+ (load64 ctx 0) a) 4294967295))
  (store64 ctx 8 (& (+ (load64 ctx 8) b) 4294967295))
  (store64 ctx 16 (& (+ (load64 ctx 16) c) 4294967295))
  (store64 ctx 24 (& (+ (load64 ctx 24) d) 4294967295))
  (store64 ctx 32 (& (+ (load64 ctx 32) e) 4294967295))
  (store64 ctx 40 (& (+ (load64 ctx 40) f) 4294967295))
  (store64 ctx 48 (& (+ (load64 ctx 48) g) 4294967295))
  (store64 ctx 56 (& (+ (load64 ctx 56) h) 4294967295))
  (call __vanta_priv_unmap w 512)
  (return 0))

(fn __vanta_priv_sha256_mem (topo cap)
  (call __vanta_priv_topology_check_mem topo cap)
  (let cp (call __vanta_priv_cap_require cap 1))
  (let n (load64 cp 16))
  (if (> n 1152921504606846975)
    (block (call __vanta_priv_panic 135 "sha256 input too large" 22))
    (block))
  (let raw (load64 cp 8))
  (let ctx (call __vanta_priv_map 64))
  (let block (call __vanta_priv_map 64))
  (if (== ctx 0) (block (call __vanta_priv_panic 135 "sha256 context allocation failed" 32)) (block))
  (if (== block 0) (block (call __vanta_priv_panic 135 "sha256 block allocation failed" 30)) (block))
  (store64 ctx 0 1779033703)
  (store64 ctx 8 3144134277)
  (store64 ctx 16 1013904242)
  (store64 ctx 24 2773480762)
  (store64 ctx 32 1359893119)
  (store64 ctx 40 2600822924)
  (store64 ctx 48 528734635)
  (store64 ctx 56 1541459225)
  (let full (/ n 64))
  (let bi 0)
  (while (< bi full)
    (block
      (call __vanta_priv_sha_block ctx (+ raw (* bi 64)))
      (set bi (+ bi 1))))
  (let i 0)
  (while (< i 64) (block (store8 block i 0) (set i (+ i 1))))
  (let rem (% n 64))
  (set i 0)
  (while (< i rem)
    (block
      (store8 block i (load8 raw (+ (* full 64) i)))
      (set i (+ i 1))))
  (store8 block rem 128)
  (if (>= rem 56)
    (block
      (call __vanta_priv_sha_block ctx block)
      (set i 0)
      (while (< i 64) (block (store8 block i 0) (set i (+ i 1)))))
    (block))
  (let bitlen (* n 8))
  (store8 block 56 (& (>> bitlen 56) 255))
  (store8 block 57 (& (>> bitlen 48) 255))
  (store8 block 58 (& (>> bitlen 40) 255))
  (store8 block 59 (& (>> bitlen 32) 255))
  (store8 block 60 (& (>> bitlen 24) 255))
  (store8 block 61 (& (>> bitlen 16) 255))
  (store8 block 62 (& (>> bitlen 8) 255))
  (store8 block 63 (& bitlen 255))
  (call __vanta_priv_sha_block ctx block)
  (let words (call __vanta_priv_map 64))
  (if (== words 0) (block (call __vanta_priv_panic 135 "sha256 digest allocation failed" 31)) (block))
  (set i 0)
  (while (< i 8)
    (block
      (store64 words (* i 8) (load64 ctx (* i 8)))
      (set i (+ i 1))))
  (call __vanta_priv_unmap block 64)
  (call __vanta_priv_unmap ctx 64)
  (let d (call __vanta_priv_alloc_slot 13))
  (let dp (call __vanta_priv_slot d 13))
  (store64 dp 8 words)
  (return d))

(fn __vanta_priv_sha256_word (digest index)
  (if (< index 0) (block (call __vanta_priv_panic 135 "negative digest index" 21)) (block))
  (if (>= index 8) (block (call __vanta_priv_panic 135 "digest index out of bounds" 26)) (block))
  (let p (call __vanta_priv_slot digest 13))
  (return (load64 (load64 p 8) (* index 8))))

(fn __vanta_priv_sha256_free (digest)
  (let p (call __vanta_priv_slot digest 13))
  (call __vanta_priv_unmap (load64 p 8) 64)
  (call __vanta_priv_clear_slot digest)
  (return 0))
