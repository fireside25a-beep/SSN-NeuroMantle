; Deterministic 1024-bit nearest-key allocation into configured memory domains.
; kind 14: [kind, entries, count, mapping_bytes, ...]. Each entry is 144 bytes:
; domain handle, allocation count, sixteen little-endian u64 key lanes.

(fn __vanta_priv_spatial_slot (pool)
  (return (call __vanta_priv_slot pool 14)))

(fn __vanta_priv_spatial_new ()
  (let bytes 9072)
  (let entries (call __vanta_priv_map bytes))
  (if (== entries 0) (block (call __vanta_priv_panic 137 "spatial pool allocation failed" 30)) (block))
  (let pool (call __vanta_priv_alloc_slot 14))
  (let p (call __vanta_priv_spatial_slot pool))
  (store64 p 8 entries)
  (store64 p 16 0)
  (store64 p 24 bytes)
  (return pool))

(fn __vanta_priv_spatial_key (topo key)
  (call __vanta_priv_topology_check_mem topo key)
  (let k (call __vanta_priv_cap_require key 1))
  (if (!= (load64 k 16) 128)
    (block (call __vanta_priv_panic 137 "spatial key must be 128 bytes" 29))
    (block))
  (return k))

(fn __vanta_priv_spatial_add (topo pool key domain)
  (let p (call __vanta_priv_spatial_slot pool))
  (call __vanta_priv_slot domain 5)
  (let k (call __vanta_priv_spatial_key topo key))
  (let n (load64 p 16))
  (if (>= n 63) (block (call __vanta_priv_panic 137 "spatial pool is full" 20)) (block))
  (let entries (load64 p 8))
  (let i 0)
  (while (< i n)
    (block
      (if (== (load64 entries (* i 144)) domain)
        (block (call __vanta_priv_panic 137 "duplicate spatial domain" 24)) (block))
      (set i (+ i 1))))
  (let entry (+ entries (* n 144)))
  (store64 entry 0 domain)
  (store64 entry 8 0)
  (set i 0)
  (while (< i 16)
    (block
      (store64 entry (+ 16 (* i 8)) (load64 (load64 k 8) (* i 8)))
      (set i (+ i 1))))
  (store64 p 16 (+ n 1))
  (return n))

(fn __vanta_priv_spatial_popcount (bits)
  (let count 0)
  (while (!= bits 0)
    (block
      (set bits (& bits (wrap- bits 1)))
      (set count (+ count 1))))
  (return count))

(fn __vanta_priv_spatial_select (topo pool key)
  (let p (call __vanta_priv_spatial_slot pool))
  (let k (call __vanta_priv_spatial_key topo key))
  (let n (load64 p 16))
  (if (== n 0) (block (call __vanta_priv_panic 137 "spatial pool is empty" 21)) (block))
  (let entries (load64 p 8))
  (let selected -1)
  (let best 1025)
  (let i 0)
  (while (< i n)
    (block
      (let entry (+ entries (* i 144)))
      (let distance 0)
      (let j 0)
      (while (< j 16)
        (block
          (let a (load64 entry (+ 16 (* j 8))))
          (let b (load64 (load64 k 8) (* j 8)))
          (set distance (+ distance (call __vanta_priv_spatial_popcount (^ a b))))
          (set j (+ j 1))))
      (if (< distance best) (block (set best distance) (set selected i)) (block))
      (set i (+ i 1))))
  (return selected))

(fn __vanta_priv_spatial_alloc (topo pool key bytes perms)
  (let selected (call __vanta_priv_spatial_select topo pool key))
  (let p (call __vanta_priv_spatial_slot pool))
  (let entry (+ (load64 p 8) (* selected 144)))
  (let domain (load64 entry 0))
  (let cap (call __vanta_priv_mem_new bytes domain perms))
  (let count (load64 entry 8))
  (if (== count 9223372036854775807)
    (block (call __vanta_priv_mem_free cap) (call __vanta_priv_panic 137 "spatial allocation count overflow" 33))
    (block))
  (store64 entry 8 (+ count 1))
  (return cap))

(fn __vanta_priv_spatial_count (pool index)
  (let p (call __vanta_priv_spatial_slot pool))
  (if (< index 0) (block (call __vanta_priv_panic 137 "negative spatial index" 22)) (block))
  (if (>= index (load64 p 16)) (block (call __vanta_priv_panic 137 "spatial index out of bounds" 27)) (block))
  (return (load64 (load64 p 8) (+ (* index 144) 8))))

(fn __vanta_priv_spatial_free (pool)
  (let p (call __vanta_priv_spatial_slot pool))
  (call __vanta_priv_unmap (load64 p 8) (load64 p 24))
  (call __vanta_priv_clear_slot pool)
  (return 0))
