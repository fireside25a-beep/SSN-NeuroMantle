; Dense rank-2 signed i64 tensor. kind 3: [kind, cap, rows, cols, 0...]

(fn __vanta_priv_tensor_slot (t)
  (return (call __vanta_priv_slot t 3)))

(fn __vanta_priv_tensor_new2 (rows cols domain)
  (if (<= rows 0) (block (call __vanta_priv_panic 130 "tensor rows must be positive" 28)) (block))
  (if (<= cols 0) (block (call __vanta_priv_panic 130 "tensor cols must be positive" 28)) (block))
  (let elems (* rows cols))
  (let bytes (* elems 8))
  (let cap (call __vanta_priv_mem_new bytes domain 7))
  (let t (call __vanta_priv_alloc_slot 3))
  (let p (call __vanta_priv_tensor_slot t))
  (store64 p 8 cap)
  (store64 p 16 rows)
  (store64 p 24 cols)
  (return t))

(fn __vanta_priv_tensor_rows (t)
  (return (load64 (call __vanta_priv_tensor_slot t) 16)))

(fn __vanta_priv_tensor_cols (t)
  (return (load64 (call __vanta_priv_tensor_slot t) 24)))

(fn __vanta_priv_tensor_offset (p r c)
  (let rows (load64 p 16))
  (let cols (load64 p 24))
  (if (< r 0) (block (call __vanta_priv_panic 130 "negative tensor row" 19)) (block))
  (if (< c 0) (block (call __vanta_priv_panic 130 "negative tensor column" 22)) (block))
  (if (>= r rows) (block (call __vanta_priv_panic 130 "tensor row out of bounds" 24)) (block))
  (if (>= c cols) (block (call __vanta_priv_panic 130 "tensor column out of bounds" 27)) (block))
  (return (* (+ (* r cols) c) 8)))

(fn __vanta_priv_tensor_get64 (topo t r c)
  (let p (call __vanta_priv_tensor_slot t))
  (return (call __vanta_priv_mem_load64 topo (load64 p 8) (call __vanta_priv_tensor_offset p r c))))

(fn __vanta_priv_tensor_set64 (topo t r c v)
  (let p (call __vanta_priv_tensor_slot t))
  (return (call __vanta_priv_mem_store64 topo (load64 p 8) (call __vanta_priv_tensor_offset p r c) v)))

(fn __vanta_priv_tensor_matmul64 (topo a b out)
  (let ap (call __vanta_priv_tensor_slot a))
  (let bp (call __vanta_priv_tensor_slot b))
  (let op (call __vanta_priv_tensor_slot out))
  (let ar (load64 ap 16))
  (let ac (load64 ap 24))
  (let br (load64 bp 16))
  (let bc (load64 bp 24))
  (if (!= ac br) (block (call __vanta_priv_panic 130 "matmul inner dimension mismatch" 31)) (block))
  (if (!= (load64 op 16) ar) (block (call __vanta_priv_panic 130 "matmul output row mismatch" 27)) (block))
  (if (!= (load64 op 24) bc) (block (call __vanta_priv_panic 130 "matmul output column mismatch" 30)) (block))
  (let i 0)
  (while (< i ar)
    (block
      (let j 0)
      (while (< j bc)
        (block
          (let k 0)
          (let acc 0)
          (while (< k ac)
            (block
              (let av (call __vanta_priv_tensor_get64 topo a i k))
              (let bv (call __vanta_priv_tensor_get64 topo b k j))
              (set acc (+ acc (* av bv)))
              (set k (+ k 1))))
          (call __vanta_priv_tensor_set64 topo out i j acc)
          (set j (+ j 1))))
      (set i (+ i 1))))
  (return out))

(fn __vanta_priv_tensor_transfer (t dst_domain fabric)
  (let p (call __vanta_priv_tensor_slot t))
  (let newcap (call __vanta_priv_mem_transfer (load64 p 8) dst_domain fabric))
  (let out (call __vanta_priv_alloc_slot 3))
  (let q (call __vanta_priv_tensor_slot out))
  (store64 q 8 newcap)
  (store64 q 16 (load64 p 16))
  (store64 q 24 (load64 p 24))
  (return out))

(fn __vanta_priv_tensor_matmul_f64 (topo a b out)
  (let ap (call __vanta_priv_tensor_slot a))
  (let bp (call __vanta_priv_tensor_slot b))
  (let op (call __vanta_priv_tensor_slot out))
  (let ar (load64 ap 16))
  (let ac (load64 ap 24))
  (let br (load64 bp 16))
  (let bc (load64 bp 24))
  (if (!= ac br) (block (call __vanta_priv_panic 130 "matmul inner dimension mismatch" 31)) (block))
  (if (!= (load64 op 16) ar) (block (call __vanta_priv_panic 130 "matmul output row mismatch" 27)) (block))
  (if (!= (load64 op 24) bc) (block (call __vanta_priv_panic 130 "matmul output column mismatch" 30)) (block))
  (let i 0)
  (while (< i ar)
    (block
      (let j 0)
      (while (< j bc)
        (block
          (let k 0)
          (let acc 0)
          (while (< k ac)
            (block
              (let av (call __vanta_priv_tensor_get64 topo a i k))
              (let bv (call __vanta_priv_tensor_get64 topo b k j))
              (set acc (f64+ acc (f64* av bv)))
              (set k (+ k 1))))
          (call __vanta_priv_tensor_set64 topo out i j acc)
          (set j (+ j 1))))
      (set i (+ i 1))))
  (return out))

(fn __vanta_priv_tensor_free (t)
  (let p (call __vanta_priv_tensor_slot t))
  (call __vanta_priv_mem_free (load64 p 8))
  (call __vanta_priv_clear_slot t)
  (return 0))
