; Safe text and file handles. kind 9 = text [kind, ptr, len, ...], kind 10 = file [kind, fd, ...].

(fn __vanta_priv_text_slot (t)
  (return (call __vanta_priv_slot t 9)))

(fn __vanta_priv_text_from_raw (raw n)
  (if (< n 0) (block (call __vanta_priv_panic 131 "negative text length" 20)) (block))
  (let p (call __vanta_priv_map (+ n 1)))
  (if (== p 0) (block (call __vanta_priv_panic 131 "text allocation failed" 22)) (block))
  (call __vanta_priv_memcpy p raw n)
  (store8 p n 0)
  (let h (call __vanta_priv_alloc_slot 9))
  (let s (call __vanta_priv_text_slot h))
  (store64 s 8 p)
  (store64 s 16 n)
  (return h))

(fn __vanta_priv_text_len (t)
  (return (load64 (call __vanta_priv_text_slot t) 16)))

(fn __vanta_priv_text_eq (a b)
  (let ap (call __vanta_priv_text_slot a))
  (let bp (call __vanta_priv_text_slot b))
  (let an (load64 ap 16))
  (if (!= an (load64 bp 16)) (block (return 0)) (block))
  (let i 0)
  (while (< i an)
    (block
      (if (!= (load8 (load64 ap 8) i) (load8 (load64 bp 8) i)) (block (return 0)) (block))
      (set i (+ i 1))))
  (return 1))

(fn __vanta_priv_text_free (t)
  (let p (call __vanta_priv_text_slot t))
  (call __vanta_priv_unmap (load64 p 8) (+ (load64 p 16) 1))
  (call __vanta_priv_clear_slot t)
  (return 0))

(fn __vanta_priv_print_text (t)
  (let p (call __vanta_priv_text_slot t))
  (return (call __vanta_priv_write_all 1 (load64 p 8) (load64 p 16))))

(fn __vanta_priv_file_slot (f)
  (return (call __vanta_priv_slot f 10)))

(fn __vanta_priv_file_make (fd)
  (if (< fd 0) (block (return 0)) (block))
  (let h (call __vanta_priv_alloc_slot 10))
  (let p (call __vanta_priv_file_slot h))
  (store64 p 8 fd)
  (return h))

(fn __vanta_priv_file_open_read (path)
  (let p (call __vanta_priv_text_slot path))
  (let fd (syscall4 257 -100 (load64 p 8) 0 0))
  (if (< fd 0) (block (call __vanta_priv_panic 132 "file open for read failed" 25)) (block))
  (return (call __vanta_priv_file_make fd)))

(fn __vanta_priv_file_open_write (path)
  (let p (call __vanta_priv_text_slot path))
  (let fd (syscall4 257 -100 (load64 p 8) 577 420))
  (if (< fd 0) (block (call __vanta_priv_panic 132 "file open for write failed" 26)) (block))
  (return (call __vanta_priv_file_make fd)))

(fn __vanta_priv_file_read (topo file cap off n)
  (call __vanta_priv_topology_check_mem topo cap)
  (let cp (call __vanta_priv_cap_require cap 2))
  (call __vanta_priv_cap_bounds cp off n)
  (let fp (call __vanta_priv_file_slot file))
  (let r (syscall3 0 (load64 fp 8) (+ (load64 cp 8) off) n))
  (if (< r 0) (block (call __vanta_priv_panic 132 "file read failed" 16)) (block))
  (return r))

(fn __vanta_priv_file_write (topo file cap off n)
  (call __vanta_priv_topology_check_mem topo cap)
  (let cp (call __vanta_priv_cap_require cap 1))
  (call __vanta_priv_cap_bounds cp off n)
  (let fp (call __vanta_priv_file_slot file))
  (let r (syscall3 1 (load64 fp 8) (+ (load64 cp 8) off) n))
  (if (< r 0) (block (call __vanta_priv_panic 132 "file write failed" 17)) (block))
  (return r))

(fn __vanta_priv_file_close (file)
  (let p (call __vanta_priv_file_slot file))
  (let r (syscall1 3 (load64 p 8)))
  (call __vanta_priv_clear_slot file)
  (return r))
