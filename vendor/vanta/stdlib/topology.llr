; Topology + directed transfer fabric.
; kind 4 topology: [kind, visible_domain_bitmask, 0...]
; kind 6 fabric:   [kind, matrix_ptr, 63, 0...]

(fn __vanta_priv_topology_new ()
  (let h (call __vanta_priv_alloc_slot 4))
  (let p (call __vanta_priv_slot h 4))
  (store64 p 8 0)
  (return h))

(fn __vanta_priv_topology_add (topo domain)
  (let tp (call __vanta_priv_slot topo 4))
  (let dp (call __vanta_priv_slot domain 5))
  (let id (load64 dp 8))
  (store64 tp 8 (| (load64 tp 8) (<< 1 id)))
  (return topo))

(fn __vanta_priv_topology_can (topo cap)
  (let tp (call __vanta_priv_slot topo 4))
  (let cp (call __vanta_priv_cap_slot cap))
  (let dp (call __vanta_priv_slot (load64 cp 24) 5))
  (let id (load64 dp 8))
  (if (== (& (load64 tp 8) (<< 1 id)) 0) (block (return 0)) (block))
  (return 1))

(fn __vanta_priv_fabric_new ()
  (let bytes 31752)
  (let m (call __vanta_priv_map bytes))
  (if (== m 0) (block (call __vanta_priv_panic 129 "fabric allocation failed" 24)) (block))
  (let h (call __vanta_priv_alloc_slot 6))
  (let p (call __vanta_priv_slot h 6))
  (store64 p 8 m)
  (store64 p 16 63)
  (return h))

(fn __vanta_priv_fabric_link (fabric src_domain dst_domain cost)
  (if (<= cost 0) (block (call __vanta_priv_panic 129 "fabric cost must be positive" 28)) (block))
  (let fp (call __vanta_priv_slot fabric 6))
  (let sp (call __vanta_priv_slot src_domain 5))
  (let dp (call __vanta_priv_slot dst_domain 5))
  (let si (load64 sp 8))
  (let di (load64 dp 8))
  (let off (* (+ (* si 63) di) 8))
  (store64 (load64 fp 8) off cost)
  (return cost))

(fn __vanta_priv_fabric_cost (fabric src_domain dst_domain)
  (let fp (call __vanta_priv_slot fabric 6))
  (let sp (call __vanta_priv_slot src_domain 5))
  (let dp (call __vanta_priv_slot dst_domain 5))
  (let src (load64 sp 8))
  (let dst (load64 dp 8))
  (if (== src dst) (block (return 0)) (block))
  (let scratch (call __vanta_priv_map 1008))
  (if (== scratch 0) (block (call __vanta_priv_panic 129 "routing scratch allocation failed" 33)) (block))
  (let dist scratch)
  (let seen (+ scratch 504))
  (let inf 4611686018427387903)
  (let i 0)
  (while (< i 63)
    (block
      (store64 dist (* i 8) inf)
      (store8 seen i 0)
      (set i (+ i 1))))
  (store64 dist (* src 8) 0)
  (let step 0)
  (while (< step 63)
    (block
      (let u -1)
      (let best inf)
      (set i 0)
      (while (< i 63)
        (block
          (if (== (load8 seen i) 0)
            (block
              (let dv (load64 dist (* i 8)))
              (if (< dv best) (block (set best dv) (set u i)) (block)))
            (block))
          (set i (+ i 1))))
      (if (>= u 0)
        (block
          (store8 seen u 1)
          (let v 0)
          (while (< v 63)
            (block
              (let w (load64 (load64 fp 8) (* (+ (* u 63) v) 8)))
              (if (> w 0)
                (block
                  (let du (load64 dist (* u 8)))
                  (if (<= du (- inf w))
                    (block
                      (let alt (+ du w))
                      (if (< alt (load64 dist (* v 8)))
                        (block (store64 dist (* v 8) alt))
                        (block)))
                    (block)))
                (block))
              (set v (+ v 1))))
          (set step (+ step 1)))
        (block (set step 63)))))
  (let ans (load64 dist (* dst 8)))
  (call __vanta_priv_unmap scratch 1008)
  (if (== ans inf) (block (return -1)) (block))
  (return ans))

(fn __vanta_priv_mem_transfer (cap dst_domain fabric)
  (let cp (call __vanta_priv_cap_require cap 4))
  (let src_domain (load64 cp 24))
  (let cost (call __vanta_priv_fabric_cost fabric src_domain dst_domain))
  (if (< cost 0) (block (call __vanta_priv_panic 129 "no transfer route" 17)) (block))
  (let out (call __vanta_priv_mem_new (load64 cp 16) dst_domain (load64 cp 32)))
  (let op (call __vanta_priv_cap_slot out))
  (call __vanta_priv_memcpy (load64 op 8) (load64 cp 8) (load64 cp 16))
  (return out))

(fn __vanta_priv_topology_free (topo)
  (call __vanta_priv_slot topo 4)
  (call __vanta_priv_clear_slot topo)
  (return 0))

(fn __vanta_priv_fabric_free (fabric)
  (let p (call __vanta_priv_slot fabric 6))
  (call __vanta_priv_unmap (load64 p 8) 31752)
  (call __vanta_priv_clear_slot fabric)
  (return 0))
