; Dynamic i64 vectors backed by Vanta capability memory.
; kind 11 = vector [kind, cap, len, capacity, domain, 0, 0, generation]

(fn __vanta_priv_vec_slot (v)
  (return (call __vanta_priv_slot v 11)))

(fn __vanta_priv_vec_new (initial_capacity domain)
  (if (<= initial_capacity 0)
    (block (call __vanta_priv_panic 133 "vector capacity must be positive" 32))
    (block))
  (call __vanta_priv_slot domain 5)
  (let bytes (* initial_capacity 8))
  (let cap (call __vanta_priv_mem_new bytes domain 7))
  (let v (call __vanta_priv_alloc_slot 11))
  (let p (call __vanta_priv_vec_slot v))
  (store64 p 8 cap)
  (store64 p 16 0)
  (store64 p 24 initial_capacity)
  (store64 p 32 domain)
  (return v))

(fn __vanta_priv_vec_len (v)
  (return (load64 (call __vanta_priv_vec_slot v) 16)))

(fn __vanta_priv_vec_capacity (v)
  (return (load64 (call __vanta_priv_vec_slot v) 24)))

(fn __vanta_priv_vec_grow (topo v)
  (let p (call __vanta_priv_vec_slot v))
  (let oldcap (load64 p 8))
  (let oldn (load64 p 24))
  (call __vanta_priv_topology_check_mem topo oldcap)
  (if (> oldn 576460752303423487)
    (block (call __vanta_priv_panic 133 "vector capacity overflow" 24))
    (block))
  (let newn (* oldn 2))
  (let domain (load64 p 32))
  (let newcap (call __vanta_priv_mem_new (* newn 8) domain 7))
  (let i 0)
  (while (< i (load64 p 16))
    (block
      (let x (call __vanta_priv_mem_load64 topo oldcap (* i 8)))
      (call __vanta_priv_mem_store64 topo newcap (* i 8) x)
      (set i (+ i 1))))
  (call __vanta_priv_mem_free oldcap)
  (store64 p 8 newcap)
  (store64 p 24 newn)
  (return v))

(fn __vanta_priv_vec_push (topo v value)
  (let p (call __vanta_priv_vec_slot v))
  (let n (load64 p 16))
  (if (>= n (load64 p 24))
    (block
      (call __vanta_priv_vec_grow topo v)
      (set p (call __vanta_priv_vec_slot v)))
    (block))
  (call __vanta_priv_mem_store64 topo (load64 p 8) (* n 8) value)
  (store64 p 16 (+ n 1))
  (return (+ n 1)))

(fn __vanta_priv_vec_get (topo v index)
  (let p (call __vanta_priv_vec_slot v))
  (let n (load64 p 16))
  (if (< index 0) (block (call __vanta_priv_panic 133 "negative vector index" 21)) (block))
  (if (>= index n) (block (call __vanta_priv_panic 133 "vector index out of bounds" 26)) (block))
  (return (call __vanta_priv_mem_load64 topo (load64 p 8) (* index 8))))

(fn __vanta_priv_vec_set (topo v index value)
  (let p (call __vanta_priv_vec_slot v))
  (let n (load64 p 16))
  (if (< index 0) (block (call __vanta_priv_panic 133 "negative vector index" 21)) (block))
  (if (>= index n) (block (call __vanta_priv_panic 133 "vector index out of bounds" 26)) (block))
  (return (call __vanta_priv_mem_store64 topo (load64 p 8) (* index 8) value)))

(fn __vanta_priv_vec_free (v)
  (let p (call __vanta_priv_vec_slot v))
  (call __vanta_priv_mem_free (load64 p 8))
  (call __vanta_priv_clear_slot v)
  (return 0))
