(fn main (argc argv)
  ; f(x)=x*x+3*x at x=2 => f=10, f'=7.
  (let x (dual-var (f64-from-i64 2)))
  (let three (dual-const (f64-from-i64 3)))
  (let xx (dual-mul x x))
  (let tx (dual-mul three x))
  (let y (dual-add xx tx))
  (assert (== (dual-value y) 4621819117588971520))
  (assert (== (dual-grad y) 4619567317775286272))
  (dual-free y)
  (dual-free tx)
  (dual-free xx)
  (dual-free three)
  (dual-free x)
  (return 0))
