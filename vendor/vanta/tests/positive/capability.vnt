(fn main (argc argv)
  (let host (domain-new 0 4096))
  (let cpu (topology-new))
  (topology-add cpu host)
  (let p (mem-new 32 host 7))
  (mem-store64 cpu p 0 41)
  (mem-store64 cpu p 8 99)
  (assert (== (mem-load64 cpu p 0) 41))
  (let q (mem-sub p 8 8))
  (assert (== (mem-load64 cpu q 0) 99))
  (assert (== (mem-len q) 8))
  (mem-free q)
  (mem-free p)
  (assert (== (domain-used host) 0))
  (topology-free cpu)
  (domain-free host)
  (return 0))
