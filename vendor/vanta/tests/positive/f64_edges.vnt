(fn main (argc argv)
  (let nan (f64-bits 9221120237041090560))
  (let one (f64-from-i64 1))
  (let two (f64-from-i64 2))
  (let negzero (f64-bits -9223372036854775808))
  (let tiny (f64-bits 1))
  (assert (== (f64== nan nan) 0))
  (assert (== (f64!= nan one) 1))
  (assert (== (f64< nan one) 0))
  (assert (== (f64<= nan one) 0))
  (assert (== (f64> nan one) 0))
  (assert (== (f64>= nan one) 0))
  (assert (== (f64== one one) 1))
  (assert (== (f64< one two) 1))
  (assert (== (f64>= two one) 1))
  (assert (== (f64+ tiny tiny) 2))
  (assert (== (f64* negzero two) -9223372036854775808))
  (assert (== (f64/ one two) 4602678819172646912))
  (return 0))
