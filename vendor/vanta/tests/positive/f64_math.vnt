(fn main (argc argv)
  (let four (f64-from-i64 4))
  (let one (f64-from-i64 1))
  (let negzero (f64-bits -9223372036854775808))
  (let nan (f64-bits 9221120237041090560))
  (assert (== (f64-sqrt four) 4611686018427387904))
  (assert (== (f64-abs negzero) 0))
  (assert (== (f64-neg one) -4616189618054758400))
  (assert (== (f64-isnan nan) 1))
  (assert (== (f64-isnan one) 0))
  (return 0))
