(fn main (argc argv)
  (let d (domain-new 0 4096))
  (let cpu (topology-new))
  (topology-add cpu d)
  (let a (tensor-new2 2 2 d))
  (let b (tensor-new2 2 2 d))
  (let c (tensor-new2 2 2 d))
  (tensor-set64 cpu a 0 0 (f64-from-i64 1))
  (tensor-set64 cpu a 0 1 (f64-from-i64 2))
  (tensor-set64 cpu a 1 0 (f64-from-i64 3))
  (tensor-set64 cpu a 1 1 (f64-from-i64 4))
  (tensor-set64 cpu b 0 0 (f64-from-i64 5))
  (tensor-set64 cpu b 0 1 (f64-from-i64 6))
  (tensor-set64 cpu b 1 0 (f64-from-i64 7))
  (tensor-set64 cpu b 1 1 (f64-from-i64 8))
  (tensor-matmul-f64 cpu a b c)
  (assert (== (tensor-get64 cpu c 0 0) 4626041242239631360))
  (assert (== (tensor-get64 cpu c 0 1) 4626885667169763328))
  (assert (== (tensor-get64 cpu c 1 0) 4631248529308778496))
  (assert (== (tensor-get64 cpu c 1 1) 4632233691727265792))
  (tensor-free c)
  (tensor-free b)
  (tensor-free a)
  (topology-free cpu)
  (domain-free d)
  (return 0))
