(fn main (argc argv)
  (let d (domain-new 0 256))
  (let cpu (topology-new))
  (topology-add cpu d)
  (let p (text "/tmp/vanta-native-io.bin"))
  (let src (mem-new 8 d 7))
  (let dst (mem-new 8 d 7))
  (mem-store64 cpu src 0 3689065201426907478)
  (let wf (file-open-write p))
  (assert (== (file-write cpu wf src 0 8) 8))
  (file-close wf)
  (let rf (file-open-read p))
  (assert (== (file-read cpu rf dst 0 8) 8))
  (file-close rf)
  (assert (== (mem-load64 cpu dst 0) 3689065201426907478))
  (mem-free dst)
  (mem-free src)
  (text-free p)
  (topology-free cpu)
  (domain-free d)
  (return 0))
