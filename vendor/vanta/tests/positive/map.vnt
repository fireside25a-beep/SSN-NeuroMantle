(fn main (argc argv)
  (let d (domain-new 0 16384))
  (let cpu (topology-new))
  (topology-add cpu d)
  (let m (map-new 2 d))
  (assert (>= (map-capacity m) 8))
  (map-put cpu m 1 10)
  (map-put cpu m 2 20)
  (map-put cpu m 3 30)
  (map-put cpu m 4 40)
  (map-put cpu m 5 50)
  (map-put cpu m 6 60)
  (assert (== (map-len m) 6))
  (assert (== (map-has cpu m 4) 1))
  (assert (== (map-has cpu m 99) 0))
  (assert (== (map-get cpu m 1) 10))
  (assert (== (map-get cpu m 6) 60))
  (map-put cpu m 3 333)
  (assert (== (map-len m) 6))
  (assert (== (map-get cpu m 3) 333))
  (map-free m)
  (assert (== (domain-used d) 0))
  (topology-free cpu)
  (domain-free d)
  (return 0))
