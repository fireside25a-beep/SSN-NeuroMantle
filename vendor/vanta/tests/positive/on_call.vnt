(fn kernel (topo p v)
  (mem-store64 topo p 0 v)
  (return (mem-load64 topo p 0)))

(fn main (argc argv)
  (let d (domain-new 0 128))
  (let cpu (topology-new))
  (topology-add cpu d)
  (let p (mem-new 8 d 7))
  (assert (== (on-call cpu kernel p 77) 77))
  (mem-free p)
  (topology-free cpu)
  (domain-free d)
  (return 0))
