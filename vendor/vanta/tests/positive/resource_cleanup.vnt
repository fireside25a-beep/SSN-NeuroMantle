(fn main (argc argv)
  (let d0 (domain-new 0 4096))
  (let d1 (domain-new 1 4096))
  (let t0 (topology-new))
  (topology-add t0 d0)
  (let f (fabric-new))
  (fabric-link f d0 d1 1)
  (let a (tensor-new2 1 1 d0))
  (tensor-set64 t0 a 0 0 7)
  (tensor-free a)
  (assert (== (domain-used d0) 0))
  (topology-free t0)
  (fabric-free f)
  (domain-free d0)
  (domain-free d1)
  (return 0))
