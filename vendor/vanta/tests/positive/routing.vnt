(fn main (argc argv)
  (let d0 (domain-new 0 4096))
  (let d1 (domain-new 1 4096))
  (let d2 (domain-new 2 4096))
  (let t0 (topology-new))
  (let t2 (topology-new))
  (topology-add t0 d0)
  (topology-add t2 d2)
  (let f (fabric-new))
  (fabric-link f d0 d1 5)
  (fabric-link f d1 d2 7)
  (fabric-link f d0 d2 20)
  (assert (== (fabric-cost f d0 d2) 12))
  (let p (mem-new 16 d0 7))
  (mem-store64 t0 p 0 123456)
  (let q (mem-transfer p d2 f))
  (assert (== (mem-load64 t2 q 0) 123456))
  (mem-free q)
  (mem-free p)
  (fabric-free f)
  (topology-free t2)
  (topology-free t0)
  (domain-free d2)
  (domain-free d1)
  (domain-free d0)
  (return 0))
