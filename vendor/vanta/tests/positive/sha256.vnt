(fn main (argc argv)
  (let d (domain-new 0 4096))
  (let cpu (topology-new))
  (topology-add cpu d)

  (let abc (mem-new 3 d 7))
  (mem-store8 cpu abc 0 97)
  (mem-store8 cpu abc 1 98)
  (mem-store8 cpu abc 2 99)
  (let h1 (sha256-mem cpu abc))
  (assert (== (sha256-word h1 0) 3128432319))
  (assert (== (sha256-word h1 1) 2399260650))
  (assert (== (sha256-word h1 2) 1094795486))
  (assert (== (sha256-word h1 3) 1571693091))
  (assert (== (sha256-word h1 4) 2953011619))
  (assert (== (sha256-word h1 5) 2518121116))
  (assert (== (sha256-word h1 6) 3021012833))
  (assert (== (sha256-word h1 7) 4060091821))
  (sha256-free h1)
  (mem-free abc)

  ; 100 bytes forces full-block processing and a separate padded tail.
  (let long (mem-new 100 d 7))
  (let i 0)
  (while (< i 100)
    (block
      (mem-store8 cpu long i 97)
      (set i (+ i 1))))
  (let h2 (sha256-mem cpu long))
  (assert (== (sha256-word h2 0) 672553336))
  (assert (== (sha256-word h2 1) 2296684755))
  (assert (== (sha256-word h2 2) 2741732024))
  (assert (== (sha256-word h2 3) 857123634))
  (assert (== (sha256-word h2 4) 1745795312))
  (assert (== (sha256-word h2 5) 260887481))
  (assert (== (sha256-word h2 6) 81166628))
  (assert (== (sha256-word h2 7) 1831361038))
  (sha256-free h2)
  (mem-free long)

  (topology-free cpu)
  (domain-free d)
  (return 0))
