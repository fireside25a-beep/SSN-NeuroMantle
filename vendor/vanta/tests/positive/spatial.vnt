(fn main (argc argv)
  (let d0 (domain-new 0 4096))
  (let d1 (domain-new 1 4096))
  (let t (topology-new))
  (topology-add t d0)
  (let zeros (mem-new 128 d0 3))
  (let ones (mem-new 128 d0 3))
  (let query (mem-new 128 d0 3))
  (let i 0)
  (while (< i 16) (block
    (mem-store64 t ones (* i 8) -1)
    (set i (+ i 1))))
  (let pool (spatial-new))
  (assert (== (spatial-add t pool zeros d0) 0))
  (assert (== (spatial-add t pool ones d1) 1))
  (assert (== (spatial-select t pool query) 0))
  (let a (spatial-alloc t pool query 32 7))
  (assert (== (mem-domain a) d0))
  (assert (== (spatial-count pool 0) 1))
  (mem-free a)
  (set i 0)
  (while (< i 16) (block
    (mem-store64 t query (* i 8) -1)
    (set i (+ i 1))))
  (assert (== (spatial-select t pool query) 1))
  (let b (spatial-alloc t pool query 24 7))
  (assert (== (mem-domain b) d1))
  (assert (== (spatial-count pool 1) 1))
  (mem-free b)
  (set i 8)
  (while (< i 16) (block
    (mem-store64 t query (* i 8) 0)
    (set i (+ i 1))))
  (assert (== (spatial-select t pool query) 0))
  (spatial-free pool)
  (mem-free query)
  (mem-free ones)
  (mem-free zeros)
  (topology-free t)
  (domain-free d1)
  (domain-free d0)
  (return 0))
