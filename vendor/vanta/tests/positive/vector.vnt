(fn main (argc argv)
  (let d (domain-new 0 4096))
  (let cpu (topology-new))
  (topology-add cpu d)
  (let v (vec-new 2 d))
  (assert (== (vec-len v) 0))
  (assert (== (vec-capacity v) 2))
  (vec-push cpu v 11)
  (vec-push cpu v 22)
  (vec-push cpu v 33)
  (assert (== (vec-len v) 3))
  (assert (>= (vec-capacity v) 3))
  (assert (== (vec-get cpu v 0) 11))
  (assert (== (vec-get cpu v 1) 22))
  (assert (== (vec-get cpu v 2) 33))
  (vec-set cpu v 1 99)
  (assert (== (vec-get cpu v 1) 99))
  (vec-free v)
  (assert (== (domain-used d) 0))
  (topology-free cpu)
  (domain-free d)
  (return 0))
